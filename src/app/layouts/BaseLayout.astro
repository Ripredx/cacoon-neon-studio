---
import { ClientRouter } from "astro:transitions";
import "@/app/styles/global.css";
import { BUSINESS_CONFIG, NEON_ENGINE_CONFIG } from "@/shared/config/business";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${BUSINESS_CONFIG.name} | Antalya Manavgat Özel Tasarım LED Neon Tabela & Tablo`,
  description = "Antalya / Manavgat merkezli kişiye ve işletmeye özel LED neon tabela, pleksi neon ve kanvas neon tablo üretimi. Kendi neon yazınızı canlı tasarlayın veya hazır Shopier koleksiyonunu inceleyin.",
} = Astro.props;
---

<!doctype html>
<!--
  ==========================================================================
  CRAFTED BY : archc.studio (https://archc.studio)
  CLIENT     : C/CNEON'S (@neons.glow) — Antalya / Manavgat LED Neon Atölyesi
  DATE       : 2026-10
  ==========================================================================
-->
<html lang="tr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="archc.studio" />
    <link rel="icon" type="image/jpeg" href={BUSINESS_CONFIG.logoUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-neon-card.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-neon-card.svg" />

    <!-- Google Fonts: Space Grotesk (700 Heading) + Plus Jakarta Sans (Body) + JetBrains Mono (Specs/Prices) + Neon Preview Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bungee+Inline&family=JetBrains+Mono:wght@400;500;600;700&family=Oswald:wght@600;700&family=Pacifico&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&family=Tilt+Neon&display=swap"
      rel="stylesheet"
    />

    <ClientRouter fallback="swap" />

    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/gsap.min.js"
    ></script>
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/ScrollTrigger.min.js"
    ></script>
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/lenis@1.2.3/dist/lenis.min.js"
    ></script>
  </head>
  <body
    data-lenis-lerp={NEON_ENGINE_CONFIG.lenisLerp}
    class="min-h-dvh bg-[#050505] text-[#F4F4F6] antialiased selection:bg-white/20 selection:text-white overflow-x-hidden"
  >
    <svg class="sr-only" aria-hidden="true" focusable="false">
      <defs>
        <filter id="physical-neon-filter" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="2" result="coreBlur" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="8" result="innerHalo" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="22" result="outerHalo" />
          <feMerge>
            <feMergeNode in="outerHalo" />
            <feMergeNode in="innerHalo" />
            <feMergeNode in="coreBlur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>
    </svg>

    <slot />

    <script is:inline>
      function initStudioMotion() {
        const prefersReduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        if (prefersReduced) return;

        if (window.gsap && window.ScrollTrigger) {
          window.gsap.registerPlugin(window.ScrollTrigger);

          if (window.Lenis && !window.__ccneonsLenis) {
            const lerpVal = Number(
              document.body.getAttribute("data-lenis-lerp") || "0.09"
            );
            const lenis = new window.Lenis({
              lerp: lerpVal,
              smoothWheel: true,
              syncTouch: false,
            });
            window.__ccneonsLenis = lenis;
            lenis.on("scroll", window.ScrollTrigger.update);
            window.gsap.ticker.add((time) => {
              lenis.raf(time * 1000);
            });
            window.gsap.ticker.lagSmoothing(0);
          } else if (window.__ccneonsLenis) {
            window.__ccneonsLenis.resize();
            window.ScrollTrigger.refresh();
          }

          // Sayfa içi (#koleksiyon, #kurumsal) çapa linklerini Lenis ile yağ gibi kaydır
          document.querySelectorAll('a[href^="#"], a[href^="/#"]').forEach((anchor) => {
            if (anchor.hasAttribute("data-lenis-bound")) return;
            anchor.setAttribute("data-lenis-bound", "true");
            anchor.addEventListener("click", (e) => {
              const href = anchor.getAttribute("href") || "";
              const hashIdx = href.indexOf("#");
              if (hashIdx === -1) return;
              const targetId = href.slice(hashIdx);
              if (href.startsWith("/#") && window.location.pathname !== "/") return;
              const targetEl = document.querySelector(targetId);
              if (targetEl && window.__ccneonsLenis) {
                e.preventDefault();
                window.__ccneonsLenis.scrollTo(targetEl, { offset: -88, duration: 0.9 });
              }
            });
          });

          const archSign = document.getElementById("archc-neon-sign");
          if (archSign) {
            window.ScrollTrigger.create({
              trigger: archSign,
              start: "top 92%",
              once: true,
              onEnter: () => {
                archSign.classList.add("animate-neon-ignite");
              },
            });
          }
        }
      }

      document.addEventListener("DOMContentLoaded", initStudioMotion);
      document.addEventListener("astro:page-load", initStudioMotion);
    </script>
  </body>
</html>
