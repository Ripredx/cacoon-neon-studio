---
import { ClientRouter } from "astro:transitions";
import "@/app/styles/global.css";
import { BUSINESS_CONFIG, NEON_ENGINE_CONFIG } from "@/shared/config/business";
import GridScan from "@/shared/ui/grid-scan/GridScan";

interface Props {
  title?: string;
  description?: string;
  showGridScan?: boolean;
}

const {
  title = `${BUSINESS_CONFIG.name} | Antalya Manavgat Özel Tasarım LED Neon Tabela & Tablo`,
  description = "Antalya / Manavgat merkezli kişiye ve işletmeye özel LED neon tabela, pleksi neon ve kanvas neon tablo üretimi. Kendi neon yazınızı canlı tasarlayın veya hazır Shopier koleksiyonunu inceleyin.",
  showGridScan = true,
} = Astro.props;
---

<!doctype html>
<!--
  ==========================================================================
  CRAFTED BY : archc.studio (https://archc.studio)
  CLIENT     : CC NEON'S (@neons.glow) — Antalya / Manavgat LED Neon Atölyesi
  DATE       : 2026-10
  ==========================================================================
-->
<html lang="tr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="archc.studio" />
    <link rel="icon" type="image/jpeg" href={BUSINESS_CONFIG.logoUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-neon-card.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-neon-card.svg" />

    <!-- Google Fonts: Preconnect + Non-blocking Asynchronous Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bungee+Inline&family=JetBrains+Mono:wght@400;500;600;700&family=Oswald:wght@600;700&family=Pacifico&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&family=Tilt+Neon&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bungee+Inline&family=JetBrains+Mono:wght@400;500;600;700&family=Oswald:wght@600;700&family=Pacifico&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&family=Tilt+Neon&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Bungee+Inline&family=JetBrains+Mono:wght@400;500;600;700&family=Oswald:wght@600;700&family=Pacifico&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&family=Tilt+Neon&display=swap"
      />
    </noscript>

    <ClientRouter fallback="swap" />

    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/lenis@1.2.3/dist/lenis.min.js"
    ></script>
  </head>
  <body
    data-lenis-lerp={NEON_ENGINE_CONFIG.lenisLerp}
    class="min-h-dvh bg-[#050505] text-[#F4F4F6] antialiased selection:bg-white/20 selection:text-white overflow-x-clip"
  >
    <!-- Mobil için hafif ve performanslı CSS ızgara arka planı (0 KB JS, 0 ms TBT) -->
    <div
      aria-hidden="true"
      class="lg:hidden fixed inset-0 z-0 pointer-events-none opacity-25 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_35%,#000_60%,transparent_100%)]"
    />

    <!-- Masaüstü için React Bits <GridScan /> 3D Cyber Izgara (Sadece lg+ ekranlarda client:media ile yüklenir) -->
    {
      showGridScan && (
        <div
          id="global-page-gridscan"
          aria-hidden="true"
          class="hidden lg:block fixed inset-0 z-0 pointer-events-none overflow-hidden opacity-40"
        >
          <GridScan
            client:media="(min-width: 1024px)"
            linesColor="#4d4757"
            scanColor="#7dd3fc"
            cells={7}
            depth={3.3}
            scanDuration={2.4}
            scanDelay={1.6}
            clickEffect="ping"
          />
        </div>
      )
    }

    <svg class="sr-only" aria-hidden="true" focusable="false">
      <defs>
        <filter id="physical-neon-filter" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="2" result="coreBlur" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="8" result="innerHalo" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="22" result="outerHalo" />
          <feMerge>
            <feMergeNode in="outerHalo" />
            <feMergeNode in="innerHalo" />
            <feMergeNode in="coreBlur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>
    </svg>

    <div class="relative z-10 flex min-h-dvh flex-col">
      <slot />
    </div>

    <script is:inline>
      function initStudioMotion() {
        if (window.__ccneonsLenis) {
          window.__ccneonsLenis.destroy();
          window.__ccneonsLenis = null;
        }
        if (window.__ccneonsRafId) {
          cancelAnimationFrame(window.__ccneonsRafId);
          window.__ccneonsRafId = null;
        }

        // Yalnızca dokunmatik olmayan masaüstü ekranlarda Lenis çalıştır
        const isTouch = window.matchMedia("(pointer: coarse)").matches || window.innerWidth < 1024;
        if (!isTouch && window.Lenis) {
          const lenis = new window.Lenis({
            lerp: 0.1,
            orientation: "vertical",
            gestureOrientation: "vertical",
            smoothWheel: true,
            wheelMultiplier: 1,
            touchMultiplier: 1.5,
            infinite: false,
          });

          window.__ccneonsLenis = lenis;

          function raf(time) {
            lenis.raf(time);
            window.__ccneonsRafId = requestAnimationFrame(raf);
          }
          window.__ccneonsRafId = requestAnimationFrame(raf);
        }

        // Sayfa içi (#hero-stage, #koleksiyon, #kurumsal) çapa linklerini yakala ve yumuşak kaydır
        document.querySelectorAll('a[href^="#"], a[href^="/#"]').forEach((anchor) => {
          if (anchor.hasAttribute("data-lenis-bound")) return;
          anchor.setAttribute("data-lenis-bound", "true");
          anchor.addEventListener(
            "click",
            (e) => {
              const href = anchor.getAttribute("href") || "";
              const hashIdx = href.indexOf("#");
              if (hashIdx === -1) return;
              const targetId = href.slice(hashIdx);
              if (targetId.length <= 1) return;
              if (href.startsWith("/#") && window.location.pathname !== "/") return;
              const targetEl = document.querySelector(targetId);
              if (!targetEl) return;

              e.preventDefault();
              e.stopPropagation();

              if (window.__ccneonsLenis) {
                window.__ccneonsLenis.scrollTo(targetEl, {
                  offset: -72,
                  duration: 1.05,
                });
              } else {
                targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
              }
            },
            { capture: true }
          );
        });
      }

      window.addEventListener("DOMContentLoaded", initStudioMotion);
      window.addEventListener("load", () => {
        if (!window.__ccneonsLenis) initStudioMotion();
      });
      document.addEventListener("astro:page-load", initStudioMotion);
    </script>
  </body>
</html>
