---
import { ClientRouter } from "astro:transitions";
import "@/app/styles/global.css";
import { BUSINESS_CONFIG, NEON_ENGINE_CONFIG } from "@/shared/config/business";
import NeonPreloader from "@/widgets/preloader/ui/NeonPreloader.astro";
import LazyColorBends from "@/shared/ui/color-bends/LazyColorBends";

interface Props {
  title?: string;
  description?: string;
  showGridScan?: boolean;
}

const {
  title = `${BUSINESS_CONFIG.name} | Antalya Manavgat Özel Tasarım LED Neon Tabela & Tablo`,
  description = "Antalya / Manavgat merkezli kişiye ve işletmeye özel LED neon tabela, pleksi neon ve kanvas neon tablo üretimi. Kendi neon yazınızı canlı tasarlayın veya hazır Shopier koleksiyonunu inceleyin.",
  showGridScan = true,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL("/og-neon-card.png", Astro.site).href;
---

<!doctype html>
<!--
  ==========================================================================
  CRAFTED BY : archc.studio (https://archc.studio)
  CLIENT     : CC NEON'S (@neons.glow) — Antalya / Manavgat LED Neon Atölyesi
  DATE       : 2026-10
  ==========================================================================
-->
<html lang="tr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content={BUSINESS_CONFIG.name} />
    <link rel="icon" type="image/webp" href={BUSINESS_CONFIG.logoUrl} />
    <link rel="apple-touch-icon" href={BUSINESS_CONFIG.logoUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={BUSINESS_CONFIG.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts & CDN: Dns-prefetch + Preconnect + Non-blocking Async Stylesheet -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://cdn.shopier.app" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Pacifico&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&family=Tilt+Neon&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Pacifico&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&family=Tilt+Neon&display=swap"
      />
    </noscript>

    <slot name="head" />

    <ClientRouter fallback="swap" />

    <!-- Anında Session Kontrolü: Tekrar ziyaret ve sayfa geçişlerinde preloader'ı anında gizle -->
    <script is:inline>
      try {
        if (sessionStorage.getItem("ccneons_preloaded_once") === "true") {
          document.documentElement.classList.add("preloaded");
        }
      } catch (e) {}
    </script>
    <style is:inline>
      html.preloaded #ccneons-preloader {
        display: none !important;
      }
    </style>
  </head>
  <body
    data-lenis-lerp={NEON_ENGINE_CONFIG.lenisLerp}
    class="min-h-dvh bg-[#050505] text-[#F4F4F6] antialiased selection:bg-white/20 selection:text-white overflow-x-clip"
  >
    <!-- Siber Neon Preloader (0 KB Harici Kütüphane, Oturum Başına 1 Kez, Bot Korumalı) -->
    <NeonPreloader />
    <!-- Sayfa Geneli Donanım Hızlandırmalı Siber Neon Izgara Arka Planı (0 KB JS, 0 ms TBT) -->
    {
      showGridScan && (
        <>
          <div
            id="global-page-gridscan"
            aria-hidden="true"
            class="fixed inset-0 z-0 pointer-events-none overflow-hidden opacity-30 bg-[linear-gradient(to_right,#ffffff0c_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0c_1px,transparent_1px)] bg-[size:36px_36px] [mask-image:radial-gradient(ellipse_80%_60%_at_50%_35%,#000_50%,transparent_100%)]"
          />
          <div
            id="global-page-colorbends"
            aria-hidden="true"
            class="fixed inset-0 z-0 pointer-events-none overflow-hidden opacity-60"
          >
            <LazyColorBends
              client:only="preact"
              colors={["#35E7FF", "#FF2E88", "#FFB020"]}
              rotation={90}
              speed={0.2}
              scale={1}
              frequency={1}
              warpStrength={1}
              mouseInfluence={0.6}
              noise={0.12}
              parallax={0.5}
              iterations={1}
              intensity={1.6}
              bandWidth={6}
              transparent
            />
          </div>
        </>
      )
    }

    <svg class="sr-only" aria-hidden="true" focusable="false">
      <defs>
        <filter id="physical-neon-filter" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="2" result="coreBlur" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="8" result="innerHalo" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="22" result="outerHalo" />
          <feMerge>
            <feMergeNode in="outerHalo" />
            <feMergeNode in="innerHalo" />
            <feMergeNode in="coreBlur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>
    </svg>

    <div class="relative z-10 flex min-h-dvh flex-col">
      <slot />
    </div>

    <script is:inline>
      function initStudioMotion() {
        if (window.__ccneonsLenis) {
          window.__ccneonsLenis.destroy();
          window.__ccneonsLenis = null;
        }
        if (window.__ccneonsRafId) {
          cancelAnimationFrame(window.__ccneonsRafId);
          window.__ccneonsRafId = null;
        }

        // Yalnızca dokunmatik olmayan masaüstü ekranlarda Lenis dinamik yükle ve çalıştır (Mobilde 0 KB / 0 ms)
        const isTouch = window.matchMedia("(pointer: coarse)").matches || window.innerWidth < 1024;
        if (!isTouch) {
          const startLenis = () => {
            if (!window.Lenis || window.__ccneonsLenis) return;
            try {
              const lenis = new window.Lenis({
                lerp: 0.1,
                orientation: "vertical",
                gestureOrientation: "vertical",
                smoothWheel: true,
                wheelMultiplier: 1,
                touchMultiplier: 1.5,
                infinite: false,
              });

              window.__ccneonsLenis = lenis;

              function raf(time) {
                lenis.raf(time);
                window.__ccneonsRafId = requestAnimationFrame(raf);
              }
              window.__ccneonsRafId = requestAnimationFrame(raf);
            } catch (e) {
              console.warn("Lenis init skipped:", e);
            }
          };

          if (window.Lenis) {
            startLenis();
          } else if (!window.__ccneonsLenisScriptLoading) {
            window.__ccneonsLenisScriptLoading = true;
            const s = document.createElement("script");
            s.src = "https://cdn.jsdelivr.net/npm/lenis@1.2.3/dist/lenis.min.js";
            s.defer = true;
            s.onload = startLenis;
            document.head.appendChild(s);
          }
        }

        // Sayfa içi (#hero-stage, #koleksiyon, #kurumsal) çapa linklerini yakala ve yumuşak kaydır
        document.querySelectorAll('a[href^="#"], a[href^="/#"]').forEach((anchor) => {
          if (anchor.hasAttribute("data-lenis-bound")) return;
          anchor.setAttribute("data-lenis-bound", "true");
          anchor.addEventListener(
            "click",
            (e) => {
              const href = anchor.getAttribute("href") || "";
              const hashIdx = href.indexOf("#");
              if (hashIdx === -1) return;
              const targetId = href.slice(hashIdx);
              if (targetId.length <= 1) return;
              if (href.startsWith("/#") && window.location.pathname !== "/") return;
              const targetEl = document.querySelector(targetId);
              if (!targetEl) return;

              e.preventDefault();
              e.stopPropagation();

              if (window.__ccneonsLenis) {
                window.__ccneonsLenis.scrollTo(targetEl, {
                  offset: -72,
                  duration: 1.05,
                });
              } else {
                targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
              }
            },
            { capture: true }
          );
        });
      }

      window.addEventListener("DOMContentLoaded", initStudioMotion);
      window.addEventListener("load", () => {
        if (!window.__ccneonsLenis) initStudioMotion();
      });
      document.addEventListener("astro:page-load", initStudioMotion);
    </script>
  </body>
</html>
