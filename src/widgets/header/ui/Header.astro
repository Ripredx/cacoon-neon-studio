---
import { BUSINESS_CONFIG } from "@/shared/config/business";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 w-full border-b border-white/[0.07] bg-[#050505]/90 backdrop-blur-md transition-transform duration-300 ease-out will-change-transform translate-y-0"
>
  <nav
    aria-label="Ana Menü"
    class="flex w-full items-center justify-between px-4 sm:px-8 lg:px-12 py-3.5"
  >
    <a
      href="/"
      class="cursor-pointer flex items-center gap-3 rounded-lg focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white/40"
    >
      <img
        src={BUSINESS_CONFIG.logoUrl}
        alt="CC NEON'S Custom Neon Studio"
        width="38"
        height="38"
        class="size-9.5 rounded-lg border border-white/[0.07] object-cover grayscale-[20%]"
      />
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="font-display text-base font-bold tracking-tight text-white leading-none">
            CC NEON'S
          </span>
          <span class="font-mono rounded border border-white/10 bg-white/[0.04] px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wider text-white/70">
            EL İŞÇİLİĞİ
          </span>
        </div>
        <span class="font-mono mt-1 block text-[11px] text-white/45 tracking-tight">
          @{BUSINESS_CONFIG.handle} · {BUSINESS_CONFIG.location}
        </span>
      </div>
    </a>

    <div class="hidden md:flex items-center gap-8 text-sm font-medium text-white/60">
      <a
        href="/tasarla"
        data-astro-prefetch="viewport"
        class="cursor-pointer py-1.5 transition-colors duration-200 hover:text-white inline-flex items-center gap-1.5"
      >
        <span class="size-1.5 rounded-full bg-[#35E7FF] shadow-[0_0_6px_#35E7FF]"></span>
        <span>Canlı Neon Atölyesi</span>
      </a>
      <a
        href="/#koleksiyon"
        class="cursor-pointer py-1.5 transition-colors duration-200 hover:text-white inline-flex items-center gap-1.5"
      >
        <span>Koleksiyon</span>
        <span class="font-mono text-xs text-white/40">[16]</span>
      </a>
      <a
        href="/#kurumsal"
        class="cursor-pointer py-1.5 transition-colors duration-200 hover:text-white"
      >
        Mekan Simülatörü
      </a>
      <a
        href={BUSINESS_CONFIG.shopierUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="cursor-pointer py-1.5 transition-colors duration-200 hover:text-white"
      >
        Shopier Mağaza
      </a>
    </div>

    <div class="flex items-center gap-2">
      {
        currentPath === "/tasarla" ? (
          <a
            href="/"
            data-astro-prefetch="viewport"
            class="cursor-pointer inline-flex min-h-10 items-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-3.5 sm:px-4 py-2 font-mono text-xs font-medium text-white transition-all duration-200 hover:border-white/25 hover:bg-white/10"
          >
            <span>← GALERİYE DÖN</span>
          </a>
        ) : (
          <a
            href="/tasarla"
            data-astro-prefetch="viewport"
            class="cursor-pointer group inline-flex min-h-10 items-center gap-2 rounded-xl border border-white/10 bg-white/[0.05] px-3.5 sm:px-4 py-2 font-mono text-xs font-semibold uppercase tracking-wider text-white transition-all duration-300 hover:border-[#35E7FF]/60 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(53,231,255,0.28)]"
          >
            <span class="size-1.5 rounded-full bg-white/50 transition-all duration-300 group-hover:bg-[#35E7FF] group-hover:shadow-[0_0_8px_#35E7FF]" />
            <span>KENDİN TASARLA →</span>
          </a>
        )
      }

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Mobil menüyü aç veya kapat"
        class="md:hidden cursor-pointer inline-flex size-10 items-center justify-center rounded-xl border border-white/10 bg-white/[0.04] text-white transition-colors hover:bg-white/10"
      >
        <svg
          id="mobile-menu-icon-open"
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg
          id="mobile-menu-icon-close"
          class="hidden size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobil Navigasyon Çekmecesi (Obsidian Gallery) -->
  <div
    id="mobile-nav-drawer"
    class="hidden md:hidden border-t border-white/[0.07] bg-[#050505]/95 px-4 py-4 backdrop-blur-xl"
  >
    <div class="flex flex-col gap-1.5 font-mono text-xs">
      <a
        href="/tasarla"
        data-mobile-nav-link="true"
        class="flex items-center justify-between rounded-xl border border-[#35E7FF]/30 bg-[#0A0A0E] px-4 py-3 text-[#35E7FF] transition-colors hover:border-[#35E7FF]/60"
      >
        <span>01 / CANLI NEON ATÖLYESİ</span>
        <span>KENDİN TASARLA →</span>
      </a>
      <a
        href="/#koleksiyon"
        data-mobile-nav-link="true"
        class="flex items-center justify-between rounded-xl border border-white/[0.07] bg-[#0A0A0E] px-4 py-3 text-white/85 transition-colors hover:border-white/20 hover:text-white"
      >
        <span>02 / KOLEKSİYON</span>
        <span class="text-white/45">[16 ÜRÜN]</span>
      </a>
      <a
        href="/#kurumsal"
        data-mobile-nav-link="true"
        class="flex items-center justify-between rounded-xl border border-white/[0.07] bg-[#0A0A0E] px-4 py-3 text-white/85 transition-colors hover:border-white/20 hover:text-white"
      >
        <span>03 / MEKAN SİMÜLATÖRÜ</span>
        <span class="text-white/35">→</span>
      </a>
      <a
        href={BUSINESS_CONFIG.shopierUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-mobile-nav-link="true"
        class="flex items-center justify-between rounded-xl border border-white/[0.07] bg-[#0A0A0E] px-4 py-3 text-white/70 transition-colors hover:border-white/20 hover:text-white"
      >
        <span>04 / SHOPIER MAĞAZA</span>
        <span class="text-white/35">↗</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  function initSmartHeader() {
    const header = document.getElementById("site-header");
    const mobileToggle = document.getElementById("mobile-menu-toggle");
    const mobileDrawer = document.getElementById("mobile-nav-drawer");
    const iconOpen = document.getElementById("mobile-menu-icon-open");
    const iconClose = document.getElementById("mobile-menu-icon-close");
    if (!header) return;

    let lastScrollY = window.scrollY;
    let lastClientY = null;
    let isMobileMenuOpen = false;

    function setMobileMenu(open) {
      isMobileMenuOpen = open;
      if (!mobileToggle || !mobileDrawer) return;
      mobileToggle.setAttribute("aria-expanded", open ? "true" : "false");
      if (open) {
        mobileDrawer.classList.remove("hidden");
        if (iconOpen) iconOpen.classList.add("hidden");
        if (iconClose) iconClose.classList.remove("hidden");
        showHeader();
      } else {
        mobileDrawer.classList.add("hidden");
        if (iconOpen) iconOpen.classList.remove("hidden");
        if (iconClose) iconClose.classList.add("hidden");
      }
    }

    if (mobileToggle && !mobileToggle.hasAttribute("data-bound")) {
      mobileToggle.setAttribute("data-bound", "true");
      mobileToggle.addEventListener("click", () => {
        setMobileMenu(!isMobileMenuOpen);
      });
    }

    document.querySelectorAll("[data-mobile-nav-link='true']").forEach((link) => {
      if (link.hasAttribute("data-bound")) return;
      link.setAttribute("data-bound", "true");
      link.addEventListener("click", () => {
        setMobileMenu(false);
      });
    });

    function showHeader() {
      header.classList.remove("-translate-y-full");
      header.classList.add("translate-y-0");
    }

    function hideHeader() {
      if (isMobileMenuOpen) return;
      header.classList.remove("translate-y-0");
      header.classList.add("-translate-y-full");
    }

    function onScroll() {
      const currentY = window.scrollY;
      const delta = currentY - lastScrollY;

      if (currentY <= 48) {
        showHeader();
        lastScrollY = currentY;
      } else if (delta > 10) {
        hideHeader();
        lastScrollY = currentY;
      } else if (delta < -5) {
        showHeader();
        lastScrollY = currentY;
      }
    }

    function onMouseMove(e) {
      if (window.scrollY <= 48) return;
      if (e.clientY <= 72) {
        showHeader();
      } else if (lastClientY !== null && e.clientY - lastClientY < -14) {
        showHeader();
      }
      lastClientY = e.clientY;
    }

    if (window.__cacoonHeaderCleanup) {
      window.__cacoonHeaderCleanup();
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("mousemove", onMouseMove, { passive: true });

    window.__cacoonHeaderCleanup = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("mousemove", onMouseMove);
    };
  }

  document.addEventListener("DOMContentLoaded", initSmartHeader);
  document.addEventListener("astro:page-load", initSmartHeader);
</script>
