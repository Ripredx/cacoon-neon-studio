---
import { getVerifiedProducts } from "@/entities/product/api/getProducts";
import type { Product } from "@/entities/product/model/schema";
import { BUSINESS_CONFIG } from "@/shared/config/business";

const products = getVerifiedProducts();
const whatsappRawPhone = BUSINESS_CONFIG.phones[0].raw;

const PRODUCT_NEON_MAP: Record<
  Product["glowColor"],
  { hex: string; rgb: string; label: string }
> = {
  green: { hex: "#1CFF8A", rgb: "28, 255, 138", label: "ACID GREEN" },
  pink: { hex: "#FF2E88", rgb: "255, 46, 136", label: "CYBER PINK" },
  amber: { hex: "#FFB020", rgb: "255, 176, 32", label: "WARM GOLD" },
  red: { hex: "#FF3B3B", rgb: "255, 59, 59", label: "BLOOD RED" },
  cyan: { hex: "#35E7FF", rgb: "53, 231, 255", label: "ICE BLUE" },
  purple: { hex: "#B538FF", rgb: "181, 56, 255", label: "ULTRA VIOLET" },
};

const PRODUCT_SIZE_MAP: Record<Product["category"], string> = {
  tablo: "KANVAS · 60x40 CM",
  pleksi: "PLEKSİ · 55x40 CM",
};

const LIFESTYLE_SCENE_IDS = new Set([
  "40507796",
  "40504490",
  "40507882",
  "40508212",
]);

const tabloCount = products.filter((p) => p.category === "tablo").length;
const pleksiCount = products.filter((p) => p.category === "pleksi").length;

const customLogoWaText = encodeURIComponent(
  "Merhaba CC NEON'S, kendi logomu / tasarımımı özel neon tabela olarak yaptırmak ve 30 dakikada fiyatlandırma almak istiyorum.",
);
---

<section
  id="koleksiyon"
  class="relative bg-[#050505]/75 backdrop-blur-[2px] py-20 sm:py-28 border-b border-white/[0.07] overflow-hidden"
>
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-10">
    <!-- Bölüm Başlığı & Mimari Üst Bilgi -->
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between text-left">
      <div class="space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-mono inline-flex items-center gap-2 rounded-lg border border-white/10 bg-[#0A0A0E] px-2.5 py-1 text-xs font-medium uppercase tracking-wider text-white/80">
            <span class="size-1.5 rounded-full bg-[#1CFF8A] shadow-[0_0_8px_#1CFF8A]"></span>
            OBSIDIAN GALLERY · HAZIR KOLEKSİYON
          </span>
          <span class="font-mono rounded-lg border border-white/[0.07] bg-[#0A0A0E] px-2.5 py-1 text-xs text-white/50">
            EL İŞÇİLİĞİ · 16 PARÇA
          </span>
        </div>

        <h2
          class="font-display font-bold text-white tracking-tight"
          style="font-size: clamp(1.95rem, 3.3vw, 2.85rem); line-height: 1.06;"
        >
          Özel Üretim Neon Tablo & Pleksi Koleksiyonu
        </h2>

        <p class="max-w-[62ch] text-sm sm:text-base text-white/55 leading-relaxed">
          Her parça 12V adaptörü ve montaj donanımıyla atölyemizden gönderilir.
          Kartların üzerine gelerek eserin gerçek neon yansımasını inceleyebilir,
          <strong>"İncele →"</strong> ile duvar ölçeğini ve gece/gündüz modunu test edebilirsiniz.
        </p>
      </div>

      <a
        href={BUSINESS_CONFIG.shopierUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="cursor-pointer whitespace-nowrap self-start md:self-auto inline-flex min-h-11 items-center gap-2 rounded-xl border border-white/10 bg-[#0A0A0E] px-4 py-2.5 font-mono text-xs font-semibold uppercase tracking-wider text-white/85 transition-all duration-200 hover:border-white/25 hover:bg-white/[0.06] hover:text-white"
      >
        <span>SHOPIER MAĞAZASI [16] →</span>
      </a>
    </div>

    <!-- Filtre Sekmeleri ve Sıralama (Vanilla JS) -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-y border-white/[0.07] bg-[#0A0A0E] p-3 rounded-xl">
      <div
        class="flex flex-wrap items-center gap-1.5"
        role="tablist"
        aria-label="Ürün Kategorileri"
      >
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-filter-category="all"
          class="catalog-filter-btn cursor-pointer whitespace-nowrap inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/[0.08] px-3.5 py-2 font-mono text-xs font-semibold uppercase tracking-wider text-white transition-all duration-150"
        >
          <span>TÜMÜ</span>
          <span class="text-white/55">[{products.length}]</span>
        </button>

        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-filter-category="tablo"
          class="catalog-filter-btn cursor-pointer whitespace-nowrap inline-flex items-center gap-2 rounded-lg border border-transparent bg-transparent px-3.5 py-2 font-mono text-xs font-medium uppercase tracking-wider text-white/55 transition-all duration-150 hover:text-white"
        >
          <span>NEON KANVAS TABLOLAR</span>
          <span class="text-white/40">[{tabloCount}]</span>
        </button>

        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-filter-category="pleksi"
          class="catalog-filter-btn cursor-pointer whitespace-nowrap inline-flex items-center gap-2 rounded-lg border border-transparent bg-transparent px-3.5 py-2 font-mono text-xs font-medium uppercase tracking-wider text-white/55 transition-all duration-150 hover:text-white"
        >
          <span>PLEKSİ NEON TASARIMLAR</span>
          <span class="text-white/40">[{pleksiCount}]</span>
        </button>
      </div>

      <div class="flex items-center gap-2.5">
        <label
          for="product-sort-select"
          class="font-mono text-xs uppercase tracking-wider text-white/45 whitespace-nowrap"
        >
          SIRALA:
        </label>
        <select
          id="product-sort-select"
          class="cursor-pointer rounded-lg bg-[#050505] border border-white/10 px-3 py-2 font-mono text-xs font-medium text-white focus:border-white/30 focus:outline-none"
        >
          <option value="featured">ÖNE ÇIKANLAR</option>
          <option value="price-asc">FİYAT: DÜŞÜKTEN YÜKSEĞE</option>
          <option value="price-desc">FİYAT: YÜKSEKTEN DÜŞÜĞE</option>
        </select>
      </div>
    </div>

    <!-- Bento Grid Düzeni: 4 Sütun + 2. Satırda 2 Sütun Genişliğinde (col-span-2) Özel Tasarım CTA Kartı -->
    <div
      id="catalog-bento-grid"
      class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 items-stretch"
    >
      {
        products.map((product, index) => {
          const neon = PRODUCT_NEON_MAP[product.glowColor];
          const sizeBadge = PRODUCT_SIZE_MAP[product.category];
          const hasOwnScene = LIFESTYLE_SCENE_IDS.has(product.id);
          const waQuestionText = encodeURIComponent(
            `Merhaba CC NEON'S, "${product.title}" (${product.price.toLocaleString("tr-TR")} ₺) ürünü için hızlı sipariş oluşturmak istiyorum: ${product.shopierUrl}`,
          );
          const waUrl = `https://wa.me/${whatsappRawPhone}?text=${waQuestionText}`;

          return (
            <>
              <article
                data-product-card="true"
                data-product-id={product.id}
                data-category={product.category}
                data-price={product.price}
                data-formatted-price={`${product.price.toLocaleString("tr-TR")} ₺`}
                data-old-price={
                  product.oldPrice
                    ? `${product.oldPrice.toLocaleString("tr-TR")} ₺`
                    : ""
                }
                data-title={product.title}
                data-image={product.imageUrl}
                data-shopier-url={product.shopierUrl}
                data-wa-url={waUrl}
                data-size-badge={sizeBadge}
                data-color-label={neon.label}
                data-featured-index={index}
                data-glow-color={neon.hex}
                data-neon-rgb={neon.rgb}
                style={`--neon-color: ${neon.hex}; --neon-rgb: ${neon.rgb};`}
                class="product-card gpu-layer group relative flex flex-col justify-between rounded-xl bg-[#0A0A0E] border border-white/[0.07] p-3.5"
              >
                <!-- Kartın Altına Düşen Hafif Neon Yansıma Çizgisi (Sadece Hover'da Parlar) -->
                <div
                  aria-hidden="true"
                  class="pointer-events-none absolute -bottom-px left-6 right-6 h-px opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                  style="background: linear-gradient(90deg, transparent, var(--neon-color), transparent); box-shadow: 0 2px 18px var(--neon-color);"
                />

                <!-- Görsel Alanı: aspect-[4/5] + Üst Köşede Buzlu Cam Monospace Kategori/Boyut Rozeti -->
                <div
                  data-quickview-trigger="true"
                  class="cursor-pointer relative aspect-[4/5] w-full overflow-hidden rounded-lg bg-[#050505] border border-white/[0.07] transition-colors duration-300 group-hover:border-[var(--neon-color)]/45"
                >
                  {!hasOwnScene && (
                    <>
                      <div
                        aria-hidden="true"
                        class="pointer-events-none absolute inset-0 wall-texture-brick opacity-65"
                      />
                      <div
                        aria-hidden="true"
                        class="pointer-events-none absolute inset-0 opacity-60 transition-opacity duration-300 group-hover:opacity-100"
                        style="background: radial-gradient(circle at 50% 45%, rgba(var(--neon-rgb), 0.28) 0%, rgba(var(--neon-rgb), 0.06) 46%, rgba(5, 5, 5, 0.9) 85%);"
                      />
                    </>
                  )}

                  <img
                    src={product.imageUrl.replace('/pictures_large/', '/pictures_mid/')}
                    srcset={`${product.imageUrl.replace('/pictures_large/', '/pictures_small/')} 330w, ${product.imageUrl.replace('/pictures_large/', '/pictures_mid/')} 458w, ${product.imageUrl} 916w`}
                    sizes="(max-width: 640px) 46vw, (max-width: 1024px) 31vw, 280px"
                    alt={product.title}
                    loading={index < 2 ? "eager" : "lazy"}
                    decoding={index < 2 ? "sync" : "async"}
                    fetchpriority={index < 2 ? "high" : "auto"}
                    width="400"
                    height="500"
                    class={`size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04] ${
                      !hasOwnScene ? "relative z-10" : ""
                    }`}
                  />

                  <!-- Üst Sol Köşe: Buzlu Cam (backdrop-blur-md bg-black/50 border border-white/10) Monospace Kategori/Boyut Rozeti -->
                  <span class="font-mono absolute top-2.5 left-2.5 z-20 inline-flex items-center gap-1.5 rounded-md backdrop-blur-md bg-black/50 border border-white/10 px-2.5 py-1 text-[11px] font-medium uppercase tracking-wider text-white/90">
                    <span
                      class="size-1.5 rounded-full"
                      style="background-color: var(--neon-color); box-shadow: 0 0 8px var(--neon-color);"
                    />
                    {sizeBadge}
                  </span>

                  <!-- Üst Sağ Köşe: Varsa Monospace Durum Rozeti -->
                  {product.badge && (
                    <span class="font-mono absolute top-2.5 right-2.5 z-20 rounded-md backdrop-blur-md bg-black/50 border border-white/10 px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-white">
                      {product.badge}
                    </span>
                  )}
                </div>

                <!-- Alt Bilgi Alanı: Sol Ürün Adı + Monospace Fiyat | Sağ Ghost Button ("İncele →") + Minimalist WhatsApp İkonu -->
                <div class="mt-3.5 flex items-end justify-between gap-3 pt-1">
                  <div class="min-w-0 flex-1 text-left">
                    <h3 class="font-display text-[15px] font-bold tracking-tight text-white truncate">
                      {product.title}
                    </h3>
                    <div class="mt-1 flex items-baseline gap-2">
                      <span class="font-mono text-lg font-bold text-white transition-colors duration-300 group-hover:text-[var(--neon-color)]">
                        {product.price.toLocaleString("tr-TR")} ₺
                      </span>
                      {product.oldPrice && (
                        <span class="font-mono text-xs text-white/40 line-through">
                          {product.oldPrice.toLocaleString("tr-TR")} ₺
                        </span>
                      )}
                    </div>
                  </div>

                  <div class="flex shrink-0 items-center gap-1.5">
                    <button
                      type="button"
                      data-quickview-trigger="true"
                      class="cursor-pointer whitespace-nowrap inline-flex h-9 items-center justify-center rounded-full bg-white/5 hover:bg-white/15 border border-white/10 px-3.5 text-xs font-medium text-white transition-all duration-200 group-hover:border-[var(--neon-color)]/50"
                    >
                      İncele →
                    </button>

                    <a
                      href={waUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${product.title} için WhatsApp hızlı sipariş`}
                      title="WhatsApp Hızlı Sipariş"
                      class="cursor-pointer shrink-0 inline-flex size-9 items-center justify-center rounded-full bg-white/5 hover:bg-white/15 border border-white/10 text-white/80 hover:text-white transition-all duration-200 group-hover:border-[var(--neon-color)]/50"
                    >
                      <span class="sr-only">
                        {product.title} için WhatsApp hızlı sipariş
                      </span>
                      <svg
                        class="size-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                        />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>

              {/* 2. Satırda 2 Sütun Genişliğinde (col-span-2) Özel Tasarım Çağrı Kartı (CTA Banner) */}
              {index === 5 && (
                <aside
                  id="bento-custom-cta"
                  data-glow-color="#FF2E88"
                  style="--neon-color: #FF2E88; --neon-rgb: 255, 46, 136;"
                  class="product-card gpu-layer sm:col-span-2 lg:col-span-2 relative flex flex-col justify-between rounded-xl border border-white/[0.07] bg-[#0A0A0E] p-6 sm:p-7 overflow-hidden group"
                >
                  <div
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-0 wall-texture-brick opacity-75"
                  />
                  <div
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-0 opacity-65 transition-opacity duration-300 group-hover:opacity-100"
                    style="background: radial-gradient(circle at 80% 40%, rgba(255, 46, 136, 0.22) 0%, rgba(53, 231, 255, 0.08) 45%, transparent 75%);"
                  />

                  <div class="relative z-10 flex flex-wrap items-center justify-between gap-2">
                    <span class="font-mono inline-flex items-center gap-2 rounded-md backdrop-blur-md bg-black/50 border border-white/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-white">
                      <span class="size-1.5 rounded-full bg-[#FF2E88] shadow-[0_0_8px_#FF2E88]" />
                      CUSTOM STUDIO · ÖZEL ÜRETİM
                    </span>
                    <span class="font-mono rounded-md backdrop-blur-md bg-black/50 border border-white/10 px-2.5 py-1 text-[11px] text-white/75">
                      EL İŞÇİLİĞİ · CNC LAZER PAFTA
                    </span>
                  </div>

                  <div class="relative z-10 my-6 grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                    <div class="md:col-span-7 space-y-3 text-left">
                      <h3 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-white leading-tight">
                        Kendi Logonu veya Tasarımını Yükle — 30 Dakikada Fiyatlandırma
                      </h3>
                      <p class="text-sm text-white/60 leading-relaxed">
                        Marka logonuzu aşağıda canlı mekan simülatörüne yükleyip
                        duvarda neon olarak test edin veya doğrudan WhatsApp'tan
                        iletin; 30 dakika içinde CNC kesim paftasını ve net
                        fiyatını çıkaralım.
                      </p>
                    </div>

                    <div class="md:col-span-5 flex items-center justify-center">
                      <div
                        class="w-full rounded-xl border border-white/10 bg-[#050505]/90 px-4 py-6 text-center backdrop-blur-md transition-all duration-300 group-hover:border-[#FF2E88]/50"
                        style="box-shadow: 0 18px 40px rgba(0, 0, 0, 0.8), 0 0 28px rgba(255, 46, 136, 0.18), inset 0 0 16px rgba(255, 46, 136, 0.08);"
                      >
                        <p
                          class="font-neon-mono text-2xl sm:text-3xl font-bold tracking-tight text-[#FF2E88]"
                          style="text-shadow: 0 0 5px #fff, 0 0 20px currentColor, 0 0 40px currentColor;"
                        >
                          YOUR LOGO
                        </p>
                        <p class="font-mono mt-2 text-[11px] uppercase tracking-wider text-white/60">
                          30 DK İÇİNDE CAD PAFTA & TEKLİF
                        </p>
                      </div>
                    </div>
                  </div>

                  <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-white/[0.07]">
                    <div class="flex flex-wrap items-center gap-2">
                      <a
                        href="#kurumsal"
                        data-trigger-logo-upload="true"
                        class="cursor-pointer whitespace-nowrap inline-flex h-10 items-center justify-center gap-2 rounded-full bg-white/5 hover:bg-white/15 border border-white/10 px-4 text-xs font-semibold text-white transition-all duration-200 group-hover:border-[#FF2E88]/60 group-hover:shadow-[0_0_20px_rgba(255,46,136,0.3)]"
                      >
                        <span>Logonu Sahnede Dene (PNG/SVG) →</span>
                      </a>

                      <a
                        href={`https://wa.me/${whatsappRawPhone}?text=${customLogoWaText}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="cursor-pointer whitespace-nowrap inline-flex h-10 items-center justify-center rounded-full bg-white/5 hover:bg-white/15 border border-white/10 px-4 font-mono text-xs font-medium text-white/80 hover:text-white transition-all duration-200"
                      >
                        WhatsApp Fiyat Al →
                      </a>
                    </div>

                    <span class="font-mono text-[11px] text-white/45">
                      MAX 30 DK DÖNÜŞ SÜRESİ
                    </span>
                  </div>
                </aside>
              )}
            </>
          );
        })
      }
    </div>
  </div>

  <!-- HIZLI İNCELEME (QUICK-VIEW MODAL: Gece/Gündüz Modu + Gerçek Ölçek Cetveli) -->
  <div
    id="product-quickview-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="qv-title"
    aria-hidden="true"
    style="--neon-color: #1CFF8A; --neon-rgb: 28, 255, 138;"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-black/80 backdrop-blur-md"
  >
    <div
      id="qv-dialog-box"
      data-lenis-prevent
      class="relative w-full max-w-4xl rounded-xl border border-white/15 bg-[#0A0A0E] shadow-[0_32px_100px_rgba(0,0,0,0.95)] overflow-hidden grid grid-cols-1 md:grid-cols-12"
    >
      <!-- Sol: Canlı Gece/Gündüz ve Ölçek Sahnesi (6 Sütun) -->
      <div class="md:col-span-6 relative min-h-[360px] sm:min-h-[440px] bg-[#050505] border-b md:border-b-0 md:border-r border-white/[0.07] flex flex-col justify-between p-4 overflow-hidden">
        <div
          id="qv-wall-bg"
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 wall-texture-brick opacity-75 transition-opacity duration-300"
        />
        <div
          id="qv-ambient-glow"
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 transition-opacity duration-300"
          style="background: radial-gradient(circle at 50% 48%, rgba(var(--neon-rgb), 0.45) 0%, rgba(var(--neon-rgb), 0.12) 45%, transparent 75%);"
        />

        <!-- Üst Bar: Rozet + Gece/Gündüz Anahtarı -->
        <div class="relative z-20 flex items-center justify-between gap-2">
          <span
            id="qv-size-badge"
            class="font-mono inline-flex items-center gap-1.5 rounded-md backdrop-blur-md bg-black/60 border border-white/10 px-2.5 py-1 text-[11px] font-medium uppercase tracking-wider text-white"
          >
            KANVAS · 60x40 CM
          </span>

          <button
            id="qv-light-toggle"
            type="button"
            aria-pressed="true"
            class="cursor-pointer inline-flex items-center gap-2 rounded-lg border border-white/15 bg-black/70 px-3 py-1 font-mono text-[11px] font-semibold uppercase tracking-wider text-white transition-colors hover:border-white/30"
          >
            <span
              id="qv-light-dot"
              class="size-2 rounded-full"
              style="background-color: var(--neon-color); box-shadow: 0 0 8px var(--neon-color);"
            />
            <span id="qv-light-label">GECE MODU (AÇIK)</span>
          </button>
        </div>

        <!-- Merkez Ürün Görseli -->
        <div class="relative z-10 my-auto flex items-center justify-center py-4">
          <img
            id="qv-image"
            src=""
            alt=""
            class="max-h-[290px] w-auto rounded-lg object-contain transition-all duration-300"
            style="box-shadow: 0 20px 50px rgba(0,0,0,0.85), 0 0 36px rgba(var(--neon-rgb), 0.35);"
          />
        </div>

        <!-- Alt Ölçek Cetveli -->
        <div class="relative z-20 flex items-center justify-between gap-2 font-mono text-[11px] text-white/70 pt-2 border-t border-white/[0.07]">
          <span>←</span>
          <div class="h-px flex-1 bg-white/20" />
          <span id="qv-scale-ruler" class="font-semibold text-white">
            GERÇEK DUVAR ÖLÇEĞİ: 60 × 40 CM
          </span>
          <div class="h-px flex-1 bg-white/20" />
          <span>→</span>
        </div>
      </div>

      <!-- Sağ: Mühendislik Detayları & Sipariş Aksiyonları (6 Sütun) -->
      <div class="md:col-span-6 flex flex-col justify-between p-6 sm:p-7 text-left space-y-6">
        <div class="space-y-4">
          <div class="flex items-start justify-between gap-3">
            <span
              id="qv-color-label"
              class="font-mono inline-flex items-center gap-2 rounded border border-white/10 bg-[#050505] px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-white/80"
            >
              EL İŞÇİLİĞİ NEON
            </span>

            <button
              id="qv-close-btn"
              type="button"
              aria-label="İnceleme penceresini kapat"
              class="cursor-pointer rounded-lg border border-white/10 bg-[#050505] px-2.5 py-1 font-mono text-xs text-white/65 hover:border-white/25 hover:text-white"
            >
              ✕ ESC
            </button>
          </div>

          <div>
            <h3
              id="qv-title"
              class="font-display text-2xl font-bold tracking-tight text-white"
            >
              Ürün Adı
            </h3>
            <div class="mt-2 flex items-baseline gap-2.5">
              <span
                id="qv-price"
                class="font-mono text-2xl sm:text-3xl font-bold"
                style="color: var(--neon-color);"
              >
                1.400 ₺
              </span>
              <span
                id="qv-old-price"
                class="font-mono text-sm text-white/40 line-through"
              />
            </div>
          </div>

          <p class="text-sm text-white/55 leading-relaxed">
            CC NEON'S atölyesinde 1. sınıf esnek silikon LED neon ve CNC kesim
            yüzey üzerine el işçiliğiyle üretilir. Kutusundan çıkan 12V adaptörü
            ile fişe takıp saniyeler içinde çalıştırabilirsiniz.
          </p>

          <!-- 4 Hücreli Teknik Mühendislik Tablosu -->
          <div class="grid grid-cols-2 gap-2.5 pt-1 font-mono">
            <div class="rounded-lg border border-white/[0.07] bg-[#050505] p-3">
              <span class="block text-[10px] uppercase tracking-wider text-white/40">
                TÜP TEKNOLOJİSİ
              </span>
              <span class="mt-0.5 block text-xs font-semibold text-white">
                8MM SİLİKON LED
              </span>
            </div>
            <div class="rounded-lg border border-white/[0.07] bg-[#050505] p-3">
              <span class="block text-[10px] uppercase tracking-wider text-white/40">
                GÜÇ & ADAPTÖR
              </span>
              <span class="mt-0.5 block text-xs font-semibold text-white">
                12V 2A TRAFO DAHİL
              </span>
            </div>
            <div class="rounded-lg border border-white/[0.07] bg-[#050505] p-3">
              <span class="block text-[10px] uppercase tracking-wider text-white/40">
                MONTAJ DONANIMI
              </span>
              <span class="mt-0.5 block text-xs font-semibold text-white">
                KROM VİDA & ASKI SETİ
              </span>
            </div>
            <div class="rounded-lg border border-white/[0.07] bg-[#050505] p-3">
              <span class="block text-[10px] uppercase tracking-wider text-white/40">
                TESLİMAT & GÜVENCE
              </span>
              <span class="mt-0.5 block text-xs font-semibold text-white">
                SİGORTALI KORUMALI KUTU
              </span>
            </div>
          </div>
        </div>

        <div class="space-y-2.5 pt-4 border-t border-white/[0.07]">
          <a
            id="qv-shopier-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="cursor-pointer w-full inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/[0.08] px-5 py-3 font-mono text-xs font-semibold uppercase tracking-wider text-white transition-all duration-200 hover:border-[var(--neon-color)] hover:bg-white/[0.15] hover:shadow-[0_0_24px_rgba(var(--neon-rgb),0.35)]"
          >
            <span>SHOPIER GÜVENCESİYLE SATIN AL →</span>
          </a>

          <a
            id="qv-wa-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="cursor-pointer w-full inline-flex min-h-10 items-center justify-center gap-2 rounded-xl border border-white/[0.07] bg-[#050505] px-5 py-2.5 font-mono text-xs font-medium text-white/75 transition-all duration-200 hover:border-white/25 hover:text-white"
          >
            <span>WHATSAPP'TAN HIZLI SİPARİŞ & SORU SOR</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  function initCatalogInteractions() {
    const grid = document.getElementById("catalog-bento-grid");
    const filterBtns = document.querySelectorAll(".catalog-filter-btn");
    const sortSelect = document.getElementById("product-sort-select");
    const bentoCta = document.getElementById("bento-custom-cta");

    // Quick-View Modal Elemanları
    const modal = document.getElementById("product-quickview-modal");
    const closeBtn = document.getElementById("qv-close-btn");
    const qvImage = document.getElementById("qv-image");
    const qvTitle = document.getElementById("qv-title");
    const qvPrice = document.getElementById("qv-price");
    const qvOldPrice = document.getElementById("qv-old-price");
    const qvSizeBadge = document.getElementById("qv-size-badge");
    const qvColorLabel = document.getElementById("qv-color-label");
    const qvScaleRuler = document.getElementById("qv-scale-ruler");
    const qvShopierLink = document.getElementById("qv-shopier-link");
    const qvWaLink = document.getElementById("qv-wa-link");
    const qvLightToggle = document.getElementById("qv-light-toggle");
    const qvLightLabel = document.getElementById("qv-light-label");
    const qvLightDot = document.getElementById("qv-light-dot");
    const qvAmbientGlow = document.getElementById("qv-ambient-glow");
    const qvWallBg = document.getElementById("qv-wall-bg");

    if (!grid) return;

    let activeCategory = "all";
    let activeSort = "featured";
    let isQvNight = true;
    let currentQvHex = "#1CFF8A";
    let currentQvRgb = "28, 255, 138";

    function applyQvLighting() {
      if (!modal || !qvImage) return;
      if (isQvNight) {
        if (qvAmbientGlow) qvAmbientGlow.style.opacity = "1";
        if (qvWallBg) qvWallBg.style.opacity = "0.75";
        qvImage.style.filter = "brightness(1.04) contrast(1.08)";
        qvImage.style.boxShadow = `0 20px 50px rgba(0,0,0,0.85), 0 0 42px rgba(${currentQvRgb}, 0.42)`;
        if (qvLightLabel) qvLightLabel.textContent = "GECE MODU (AÇIK)";
        if (qvLightDot) {
          qvLightDot.style.backgroundColor = currentQvHex;
          qvLightDot.style.boxShadow = `0 0 8px ${currentQvHex}`;
        }
      } else {
        if (qvAmbientGlow) qvAmbientGlow.style.opacity = "0.18";
        if (qvWallBg) qvWallBg.style.opacity = "0.35";
        qvImage.style.filter = "brightness(0.92) contrast(1.0)";
        qvImage.style.boxShadow = "0 14px 30px rgba(0,0,0,0.6)";
        if (qvLightLabel) qvLightLabel.textContent = "GÜNDÜZ MODU (ODA IŞIĞI)";
        if (qvLightDot) {
          qvLightDot.style.backgroundColor = "rgba(255,255,255,0.4)";
          qvLightDot.style.boxShadow = "none";
        }
      }
    }

    function openQuickView(card) {
      if (!modal) return;
      const title = card.getAttribute("data-title") || "";
      const price = card.getAttribute("data-formatted-price") || "";
      const oldPrice = card.getAttribute("data-old-price") || "";
      const img = card.getAttribute("data-image") || "";
      const shopier = card.getAttribute("data-shopier-url") || "#";
      const wa = card.getAttribute("data-wa-url") || "#";
      const sizeBadge = card.getAttribute("data-size-badge") || "60x40 CM";
      const colorLabel = card.getAttribute("data-color-label") || "NEON";
      currentQvHex = card.getAttribute("data-glow-color") || "#1CFF8A";
      currentQvRgb = card.getAttribute("data-neon-rgb") || "28, 255, 138";

      modal.style.setProperty("--neon-color", currentQvHex);
      modal.style.setProperty("--neon-rgb", currentQvRgb);

      if (qvTitle) qvTitle.textContent = title;
      if (qvPrice) qvPrice.textContent = price;
      if (qvOldPrice) qvOldPrice.textContent = oldPrice;
      if (qvImage) {
        qvImage.setAttribute("src", img);
        qvImage.setAttribute("alt", title);
      }
      if (qvSizeBadge) qvSizeBadge.textContent = sizeBadge;
      if (qvColorLabel) {
        qvColorLabel.textContent = `${colorLabel} · EL İŞÇİLİĞİ`;
      }
      if (qvScaleRuler) {
        qvScaleRuler.textContent = `GERÇEK DUVAR ÖLÇEĞİ: ${sizeBadge}`;
      }
      if (qvShopierLink) qvShopierLink.setAttribute("href", shopier);
      if (qvWaLink) qvWaLink.setAttribute("href", wa);

      isQvNight = true;
      applyQvLighting();

      modal.classList.remove("hidden");
      modal.classList.add("flex");
      modal.setAttribute("aria-hidden", "false");
    }

    function closeQuickView() {
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      modal.setAttribute("aria-hidden", "true");
    }

    grid.querySelectorAll("[data-quickview-trigger='true']").forEach((el) => {
      el.addEventListener("click", (e) => {
        const card = e.currentTarget.closest("[data-product-card='true']");
        if (card) openQuickView(card);
      });
    });

    if (qvLightToggle) {
      qvLightToggle.addEventListener("click", () => {
        isQvNight = !isQvNight;
        applyQvLighting();
      });
    }

    if (closeBtn) closeBtn.addEventListener("click", closeQuickView);
    if (modal) {
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeQuickView();
      });
    }
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeQuickView();
    });

    // Bento CTA "Logonu Sahnede Dene" tıklandığında aşağıdaki simülatörün dosya seçicisini tetikle
    const logoTrigger = document.querySelector("[data-trigger-logo-upload='true']");
    if (logoTrigger) {
      logoTrigger.addEventListener("click", () => {
        setTimeout(() => {
          const fileInput = document.getElementById("b2b-logo-file-input");
          if (fileInput) fileInput.click();
        }, 650);
      });
    }

    function updateGrid() {
      const cards = Array.from(
        grid.querySelectorAll("[data-product-card='true']")
      );

      cards.forEach((card) => {
        const cat = card.getAttribute("data-category");
        const visible = activeCategory === "all" || cat === activeCategory;
        card.style.display = visible ? "" : "none";
      });

      const sortedCards = [...cards].sort((a, b) => {
        const priceA = Number(a.getAttribute("data-price") || 0);
        const priceB = Number(b.getAttribute("data-price") || 0);
        const idxA = Number(a.getAttribute("data-featured-index") || 0);
        const idxB = Number(b.getAttribute("data-featured-index") || 0);

        if (activeSort === "price-asc") return priceA - priceB;
        if (activeSort === "price-desc") return priceB - priceA;
        return idxA - idxB;
      });

      const visibleCards = sortedCards.filter(
        (c) => c.style.display !== "none"
      );
      const hiddenCards = sortedCards.filter((c) => c.style.display === "none");

      const insertPos = Math.min(6, visibleCards.length);
      visibleCards.forEach((c, idx) => {
        if (idx === insertPos && bentoCta) {
          grid.appendChild(bentoCta);
        }
        grid.appendChild(c);
      });
      if (insertPos === visibleCards.length && bentoCta) {
        grid.appendChild(bentoCta);
      }
      hiddenCards.forEach((c) => grid.appendChild(c));
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCategory = btn.getAttribute("data-filter-category") || "all";

        filterBtns.forEach((b) => {
          b.setAttribute("aria-selected", "false");
          b.classList.remove(
            "border-white/20",
            "bg-white/[0.08]",
            "text-white",
            "font-semibold"
          );
          b.classList.add(
            "border-transparent",
            "bg-transparent",
            "text-white/55",
            "font-medium"
          );
        });

        btn.setAttribute("aria-selected", "true");
        btn.classList.remove(
          "border-transparent",
          "bg-transparent",
          "text-white/55",
          "font-medium"
        );
        btn.classList.add(
          "border-white/20",
          "bg-white/[0.08]",
          "text-white",
          "font-semibold"
        );

        updateGrid();
      });
    });

    if (sortSelect) {
      sortSelect.addEventListener("change", (e) => {
        activeSort = e.target.value || "featured";
        updateGrid();
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initCatalogInteractions);
  document.addEventListener("astro:page-load", initCatalogInteractions);
</script>
