---
import { BUSINESS_CONFIG } from "@/shared/config/business";
---

<footer class="bg-[#050505]/85 backdrop-blur-[2px] border-t border-white/[0.07] py-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3 text-left">
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <img
            src={BUSINESS_CONFIG.logoUrl}
            alt="CC NEON'S Custom Neon Studio"
            width="38"
            height="38"
            class="size-9.5 rounded-lg border border-white/[0.07] object-cover"
          />
          <div>
            <span class="font-display text-lg font-bold tracking-tight text-white block leading-none">
              CC NEON'S
            </span>
            <span class="font-mono text-[11px] text-white/70">
              @{BUSINESS_CONFIG.handle} · EL İŞÇİLİĞİ NEON ATÖLYESİ
            </span>
          </div>
        </div>
        <p class="text-sm text-white/55 text-pretty max-w-sm leading-relaxed">
          Kişiye ve işletmeye özel el işçiliği LED neon tabela, lazer kesim pleksi
          ve kanvas aydınlatma tasarımları. {BUSINESS_CONFIG.location} merkezli
          atölye üretimi, tüm Türkiye'ye sigortalı gönderim.
        </p>
      </div>

      <div class="space-y-3">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-white/50">
          ATÖLYE BÖLÜMLERİ
        </h3>
        <ul class="space-y-2 text-sm text-white/65">
          <li>
            <a
              href="/tasarla"
              class="cursor-pointer hover:text-white transition-colors"
            >
              01 / Canlı Neon Atölyesi (Customizer)
            </a>
          </li>
          <li>
            <a
              href="/#koleksiyon"
              class="cursor-pointer hover:text-white transition-colors"
            >
              02 / Hazır Koleksiyon [16 Parça]
            </a>
          </li>
          <li>
            <a
              href="/#kurumsal"
              class="cursor-pointer hover:text-white transition-colors"
            >
              03 / Canlı Mekan Simülatörü
            </a>
          </li>
          <li>
            <a
              href={BUSINESS_CONFIG.shopierUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="cursor-pointer hover:text-white transition-colors"
            >
              04 / Shopier Güvenceli Mağaza
            </a>
          </li>
        </ul>
      </div>

      <div class="space-y-3">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-white/50">
          İLETİŞİM & ATÖLYE
        </h3>
        <ul class="space-y-2 font-mono text-xs text-white/65">
          <li>KONUM: {BUSINESS_CONFIG.location.toUpperCase()}</li>
          {
            BUSINESS_CONFIG.phones.map((p) => (
              <li>
                <a
                  href={`tel:+${p.raw}`}
                  class="cursor-pointer hover:text-white transition-colors"
                >
                  TEL: {p.display}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={BUSINESS_CONFIG.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="cursor-pointer text-white/80 hover:text-white hover:underline transition-colors"
            >
              INSTAGRAM: @{BUSINESS_CONFIG.handle}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-white/[0.07] pt-8 font-mono text-xs text-white/70">
      <p>© {new Date().getFullYear()} {BUSINESS_CONFIG.name}. TÜM HAKLARI SAKLIDIR.</p>

      <div
        id="developer-signature"
        class="flex flex-wrap items-center gap-3"
      >
        <span>{BUSINESS_CONFIG.studioCredit.note}</span>
        <a
          id="archc-neon-sign"
          href={BUSINESS_CONFIG.studioCredit.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Arch/C Studio web sitesini yeni sekmede aç"
          class="inline-flex flex-col items-center justify-center group cursor-pointer transition-transform duration-300 hover:scale-105"
          style="text-decoration: none;"
        >
          <span
            class="font-semibold text-[26px] md:text-[28px] tracking-[-0.05em] leading-none text-white group-hover:text-[#4D70FF] transition-colors duration-500"
            style="font-family: 'Outfit', sans-serif;"
          >
            &lt;Arch/C&gt;
          </span>
          <span
            class="text-[10px] tracking-[0.4em] uppercase text-white/70 mt-1 pl-[0.4em] group-hover:text-[#4D70FF] transition-colors duration-500"
            style="font-family: 'JetBrains Mono', monospace;"
          >
            STUDIO
          </span>
        </a>
      </div>
    </div>
  </div>
</footer>
