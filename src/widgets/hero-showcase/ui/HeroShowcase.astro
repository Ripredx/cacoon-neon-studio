---
import { BUSINESS_CONFIG } from "@/shared/config/business";
---

<section
  id="hero-stage"
  style="--neon-color: #35E7FF; --neon-rgb: 53, 231, 255;"
  class="relative min-h-dvh flex flex-col justify-between bg-transparent pt-24 sm:pt-28 border-b border-white/[0.07] overflow-hidden"
>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 my-auto py-8 sm:py-12">
    <!-- Ana Mimari Galeri Çerçevesi -->
    <div class="relative rounded-xl border border-white/[0.07] bg-[#0A0A0E] overflow-hidden">
      <!-- Arka Plan Katmanı: Yalnızca Sağdaki Neon Enstalasyondan Sızan Dinamik Işık -->
      <div
        id="hero-ambient-glow"
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 transition-all duration-700"
        style="background: radial-gradient(circle at 74% 46%, rgba(var(--neon-rgb), 0.24) 0%, rgba(var(--neon-rgb), 0.06) 42%, transparent 72%);"
      >
      </div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 items-stretch">
        <!-- SOL KOLON (6 Sütun): Mimari Manifesto & Canlı Neon Atölyesi (/tasarla) Yönlendirme Kapıları -->
        <div class="lg:col-span-6 flex flex-col justify-between p-6 sm:p-10 lg:p-12 border-b lg:border-b-0 lg:border-r border-white/[0.07] text-left">
          <div class="space-y-6">
            <!-- Üst Teknik Rozetler -->
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-mono inline-flex items-center gap-2 rounded-lg border border-white/10 bg-[#050505] px-3 py-1 text-xs font-medium uppercase tracking-wider text-white/85">
                <span
                  id="hero-eyebrow-dot"
                  class="size-1.5 rounded-full transition-all duration-500"
                  style="background-color: var(--neon-color); box-shadow: 0 0 8px var(--neon-color);"
                ></span>
                EL İŞÇİLİĞİ · ÖZEL ÜRETİM
              </span>
              <span class="font-mono rounded-lg border border-white/[0.07] bg-[#050505]/70 px-2.5 py-1 text-xs text-white/50">
                CC NEON'S · {BUSINESS_CONFIG.location.toUpperCase()}
              </span>
            </div>

            <!-- Ana Başlık (Space Grotesk 700) -->
            <h1
              class="font-display font-bold text-white tracking-tight"
              style="font-size: clamp(2.25rem, 3.8vw, 3.65rem); line-height: 1.03;"
            >
              <span class="block">Karanlığı Kesen</span>
              <span class="block text-white/90">El İşçiliği</span>
              <span
                id="hero-title-neon"
                class="mt-1.5 block transition-all duration-500"
                style="color: var(--neon-color); text-shadow: 0 0 5px #fff, 0 0 20px currentColor, 0 0 42px currentColor;"
              >
                Özel Neon Mimari.
              </span>
            </h1>

            <!-- Galeri Açıklaması -->
            <p class="max-w-[54ch] text-sm sm:text-base text-white/60 leading-relaxed">
              Standart fabrikasyon kalıplar değil; mekanınızın dokusuna göre 1. sınıf
              şeffaf akrilik üzerine CNC lazerle işlenen, el işçiliğiyle bükülen silikon
              LED neon tablolar ve kurumsal mekan tabelaları.
            </p>

            <!-- Birincil Aksiyon Kapıları: Canlı Neon Atölyesi (/tasarla) & Hazır Koleksiyon -->
            <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <a
                id="hero-to-studio-cta"
                href="/tasarla#text=C%2FCNEON'S&color=cyan&font=modern&size=md"
                data-astro-prefetch="viewport"
                class="cursor-pointer group flex-1 whitespace-nowrap inline-flex min-h-13 items-center justify-center gap-3 rounded-xl border border-white/20 bg-white/[0.07] px-6 py-3.5 font-mono text-xs sm:text-sm font-semibold uppercase tracking-wider text-white transition-all duration-300 hover:border-[var(--neon-color)] hover:bg-white/[0.12] hover:shadow-[0_0_32px_rgba(var(--neon-rgb),0.4)]"
              >
                <span
                  class="size-2 rounded-full transition-all duration-300"
                  style="background-color: var(--neon-color); box-shadow: 0 0 10px var(--neon-color);"
                ></span>
                <span>CANLI NEON ATÖLYESİNİ AÇ →</span>
              </a>

              <a
                href="#koleksiyon"
                class="cursor-pointer whitespace-nowrap inline-flex min-h-13 items-center justify-center rounded-xl border border-white/[0.07] bg-[#050505] px-5 py-3.5 font-mono text-xs sm:text-sm font-medium text-white/75 transition-all duration-200 hover:border-white/25 hover:text-white"
              >
                KOLEKSİYON [16] ↓
              </a>
            </div>
          </div>

          <!-- Alt Bölüm: Hızlı Şablon Başlatıcıları (Tıklandığında İlgili Şablonla /tasarla Açılır) -->
          <div class="mt-10 pt-6 border-t border-white/[0.07] space-y-3">
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[11px] uppercase tracking-wider text-white/45">
                HIZLI ATÖLYE ŞABLONLARI (DOĞRUDAN STÜDYODA AÇAR)
              </span>
              <span class="font-mono text-[11px] text-white/35">
                2D CAD · ANINDA FİYAT
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <a
                href="/tasarla#text=LOUNGE&color=amber&font=script&size=lg&board=contour"
                data-astro-prefetch="viewport"
                class="cursor-pointer group flex items-center justify-between rounded-xl border border-white/[0.07] bg-[#050505] px-3.5 py-2.5 transition-all duration-200 hover:border-[#FFB020]/50 hover:bg-white/[0.03]"
              >
                <div class="flex items-center gap-2.5">
                  <span class="size-2 rounded-full bg-[#FFB020] shadow-[0_0_8px_#FFB020]"></span>
                  <span class="font-mono text-xs font-medium text-white/85 group-hover:text-white">
                    Kafe & Bar Tabelası
                  </span>
                </div>
                <span class="font-mono text-[11px] text-white/70 group-hover:text-[#FFB020] transition-colors">
                  Tasarla →
                </span>
              </a>

              <a
                href="/tasarla#text=CYBER&color=pink&font=display&size=md&board=rectangle"
                data-astro-prefetch="viewport"
                class="cursor-pointer group flex items-center justify-between rounded-xl border border-white/[0.07] bg-[#050505] px-3.5 py-2.5 transition-all duration-200 hover:border-[#FF2E88]/50 hover:bg-white/[0.03]"
              >
                <div class="flex items-center gap-2.5">
                  <span class="size-2 rounded-full bg-[#FF2E88] shadow-[0_0_8px_#FF2E88]"></span>
                  <span class="font-mono text-xs font-medium text-white/85 group-hover:text-white">
                    Oyun & Yayın Odası
                  </span>
                </div>
                <span class="font-mono text-[11px] text-white/70 group-hover:text-[#FF2E88] transition-colors">
                  Tasarla →
                </span>
              </a>

              <a
                href="/tasarla#text=STUDIO&color=cyan&font=modern&size=lg&board=contour"
                data-astro-prefetch="viewport"
                class="cursor-pointer group flex items-center justify-between rounded-xl border border-white/[0.07] bg-[#050505] px-3.5 py-2.5 transition-all duration-200 hover:border-[#35E7FF]/50 hover:bg-white/[0.03]"
              >
                <div class="flex items-center gap-2.5">
                  <span class="size-2 rounded-full bg-[#35E7FF] shadow-[0_0_8px_#35E7FF]"></span>
                  <span class="font-mono text-xs font-medium text-white/85 group-hover:text-white">
                    Ofis & Stüdyo Logosu
                  </span>
                </div>
                <span class="font-mono text-[11px] text-white/70 group-hover:text-[#35E7FF] transition-colors">
                  Tasarla →
                </span>
              </a>

              <a
                href="/tasarla#text=GOOD%20VIBES&color=green&font=script&size=sm&board=contour"
                data-astro-prefetch="viewport"
                class="cursor-pointer group flex items-center justify-between rounded-xl border border-white/[0.07] bg-[#050505] px-3.5 py-2.5 transition-all duration-200 hover:border-[#1CFF8A]/50 hover:bg-white/[0.03]"
              >
                <div class="flex items-center gap-2.5">
                  <span class="size-2 rounded-full bg-[#1CFF8A] shadow-[0_0_8px_#1CFF8A]"></span>
                  <span class="font-mono text-xs font-medium text-white/85 group-hover:text-white">
                    Ev & Oda Dekoru
                  </span>
                </div>
                <span class="font-mono text-[11px] text-white/70 group-hover:text-[#1CFF8A] transition-colors">
                  Tasarla →
                </span>
              </a>
            </div>
          </div>
        </div>

        <!-- SAĞ KOLON (6 Sütun): Sinematik Galeri Vitrini & Otomatik Sahne Geçişi -->
        <div
          id="hero-sign-frame"
          transition:name="neon-stage"
          class="relative lg:col-span-6 flex min-h-[460px] sm:min-h-[540px] flex-col justify-between bg-[#050505] overflow-hidden"
        >
          <!-- Katman 1: Gerçek Mimari Duvar Dokusu -->
          <img
            id="hero-scene-photo"
            src="/scenes/hero-brick-cafe.webp"
            alt="CC NEON'S özel üretim neon enstalasyon sahnesi"
            width="1200"
            height="800"
            fetchpriority="high"
            class="pointer-events-none absolute inset-0 size-full object-cover object-center transition-all duration-700"
            style="filter: brightness(0.24) contrast(1.22) saturate(0.85);"
          />
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 wall-texture-brick opacity-50"
          >
          </div>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0"
            style="background: radial-gradient(circle at 50% 45%, rgba(5, 5, 5, 0.1) 0%, rgba(5, 5, 5, 0.9) 88%);"
          >
          </div>

          <!-- Katman 2: Yalnızca Aktif Neondan Duvara Düşen Ambiyans Işığı -->
          <div
            id="hero-neon-backdrop"
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 transition-all duration-700"
            style="background: radial-gradient(circle at 50% 45%, rgba(var(--neon-rgb), 0.54) 0%, rgba(var(--neon-rgb), 0.18) 38%, transparent 70%); mix-blend-mode: screen;"
          >
          </div>

          <!-- Üst Vitrin Barı: Canlı Enstalasyon Telemetrisi + Atölyede Düzenle Kapsülü -->
          <div class="relative z-20 flex flex-wrap items-center justify-between gap-2 border-b border-white/[0.07] bg-[#050505]/75 px-4 py-3 sm:px-6 backdrop-blur-md">
            <div class="flex items-center gap-2">
              <span
                class="size-2 rounded-full transition-colors duration-500"
                style="background-color: var(--neon-color); box-shadow: 0 0 8px var(--neon-color);"
              ></span>
              <span
                id="hero-showcase-badge"
                class="font-mono text-[11px] font-medium uppercase tracking-wider text-white/80"
              >
                ENSTALASYON 01 / ATELIER · 85x45 CM
              </span>
            </div>

            <a
              id="hero-stage-edit-link"
              href="/tasarla#text=C%2FCNEON'S&color=cyan&font=modern&size=md"
              data-astro-prefetch="viewport"
              class="cursor-pointer inline-flex items-center gap-1.5 rounded-lg border border-white/15 bg-white/[0.06] px-3 py-1 font-mono text-[11px] font-semibold text-white transition-all duration-200 hover:border-[var(--neon-color)] hover:bg-white/15"
            >
              <span>Bu Tasarımı Atölyede Düzenle</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Merkez: Akrilik Plaka Üzerinde Nefes Alan Sinematik Neon Enstalasyonu -->
          <div class="relative z-10 my-auto flex flex-col items-center justify-center px-5 py-10 sm:px-10 text-center">
            <a
              id="hero-acrylic-plate"
              href="/tasarla#text=C%2FCNEON'S&color=cyan&font=modern&size=md"
              data-astro-prefetch="viewport"
              aria-label="Bu neon tasarımını Canlı Neon Atölyesinde aç ve özelleştir"
              class="group relative flex w-full max-w-lg min-h-[220px] sm:min-h-[250px] flex-col items-center justify-center rounded-xl border border-white/15 bg-black/35 px-6 py-10 sm:px-10 sm:py-12 backdrop-blur-[1.5px] transition-transform duration-300 hover:scale-[1.015]"
              style="box-shadow: 0 24px 68px rgba(0, 0, 0, 0.88), 0 0 52px rgba(var(--neon-rgb), 0.34), inset 0 0 26px rgba(var(--neon-rgb), 0.14);"
            >
              <!-- 4 Köşe Minimalist Krom Montaj Pimi -->
              <span class="absolute top-3.5 left-4 size-2 rounded-full bg-white/40 ring-1 ring-black"></span>
              <span class="absolute top-3.5 right-4 size-2 rounded-full bg-white/40 ring-1 ring-black"></span>
              <span class="absolute bottom-3.5 left-4 size-2 rounded-full bg-white/40 ring-1 ring-black"></span>
              <span class="absolute bottom-3.5 right-4 size-2 rounded-full bg-white/40 ring-1 ring-black"></span>

              <!-- Sağ Üst Ölçek Etiketi -->
              <span
                id="hero-plate-spec"
                class="font-mono absolute top-3.5 rounded-md border border-white/10 bg-[#050505]/70 px-2 py-0.5 text-[10px] uppercase tracking-widest text-white/55"
              >
                5MM ŞEFFAF AKRİLİK · 12V LED
              </span>

              <!-- Ana Neon Yazısı -->
              <p
                id="hero-showcase-main"
                class="animate-neon-ignite mt-2 font-bold tracking-tight select-none transition-opacity duration-300"
                style="font-family: 'Tilt Neon', sans-serif; font-size: clamp(2.6rem, 4.8vw, 4.4rem); line-height: 1.06; color: var(--neon-color); text-shadow: 0 0 5px #fff, 0 0 20px currentColor, 0 0 40px currentColor, 0 0 85px var(--neon-color);"
              >
                CC NEON'S
              </p>

              <!-- Alt Neon İmza Yazısı -->
              <p
                id="hero-showcase-sub"
                class="mt-3 text-base sm:text-xl text-white/90 select-none transition-opacity duration-300"
                style="font-family: 'Pacifico', cursive; text-shadow: 0 0 4px #fff, 0 0 14px var(--neon-color), 0 0 28px var(--neon-color);"
              >
                Glow Custom Atelier
              </p>

              <!-- Hover İpucu Kapsülü -->
              <span class="font-mono mt-5 inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-[#050505]/80 px-3 py-1 text-[10px] uppercase tracking-wider text-white/60 transition-colors group-hover:border-white/25 group-hover:text-white">
                <span>KENDİ METNİNİZİ YAZMAK İÇİN TIKLAYIN</span>
                <span aria-hidden="true">→</span>
              </span>
            </a>
          </div>

          <!-- Alt Sahne Seçici Bar: 3 Küratörlü Galeri Sahnesi (Otomatik + Tek Tıkla Geçiş) -->
          <div class="relative z-20 border-t border-white/[0.07] bg-[#050505]/85 px-4 py-3 sm:px-6 backdrop-blur-md">
            <div class="grid grid-cols-3 gap-2" role="tablist" aria-label="Galeri Vitrin Sahneleri">
              <button
                type="button"
                role="tab"
                aria-selected="true"
                data-scene-idx="0"
                class="hero-scene-tab cursor-pointer flex flex-col items-start gap-0.5 rounded-lg border border-white/25 bg-white/[0.08] px-3 py-2 text-left transition-colors duration-200"
              >
                <span class="font-mono text-[10px] uppercase tracking-wider text-[#35E7FF]">
                  01 / ATELIER
                </span>
                <span class="font-mono text-xs font-semibold text-white truncate w-full">
                  CC NEON'S · 1.850 ₺
                </span>
              </button>

              <button
                type="button"
                role="tab"
                aria-selected="false"
                data-scene-idx="1"
                class="hero-scene-tab cursor-pointer flex flex-col items-start gap-0.5 rounded-lg border border-white/[0.07] bg-white/[0.02] px-3 py-2 text-left transition-colors duration-200 hover:border-white/20"
              >
                <span class="font-mono text-[10px] uppercase tracking-wider text-white/50">
                  02 / LOUNGE
                </span>
                <span class="font-mono text-xs font-semibold text-white/75 truncate w-full">
                  LOUNGE · 2.650 ₺
                </span>
              </button>

              <button
                type="button"
                role="tab"
                aria-selected="false"
                data-scene-idx="2"
                class="hero-scene-tab cursor-pointer flex flex-col items-start gap-0.5 rounded-lg border border-white/[0.07] bg-white/[0.02] px-3 py-2 text-left transition-colors duration-200 hover:border-white/20"
              >
                <span class="font-mono text-[10px] uppercase tracking-wider text-white/50">
                  03 / CYBER
                </span>
                <span class="font-mono text-xs font-semibold text-white/75 truncate w-full">
                  ON AIR · 2.100 ₺
                </span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Alt Mimari Teknik Şerit -->
  <div
    class="marquee-wrapper relative z-10 h-12 flex items-center border-t border-white/[0.07] bg-[#0A0A0E] overflow-hidden"
    aria-label="Atölye Güvenceleri"
  >
    <div class="marquee-track font-mono text-xs uppercase tracking-wider text-white/55">
      <span class="px-8 whitespace-nowrap">CC NEON'S CUSTOM NEON ATELIER</span>
      <span class="text-white/20" aria-hidden="true">/</span>
      <span class="px-8 whitespace-nowrap">EL İŞÇİLİĞİ 1. SINIF SİLİKON LED</span>
      <span class="text-white/20" aria-hidden="true">/</span>
      <span class="px-8 whitespace-nowrap">12V ADAPTÖR VE MONTAJ SETİ DAHİL</span>
      <span class="text-white/20" aria-hidden="true">/</span>
      <span class="px-8 whitespace-nowrap">KIRILMAZ AHŞAP KASALI SİGORTALI KARGO</span>
      <span class="text-white/20" aria-hidden="true">/</span>
      <span class="px-8 whitespace-nowrap">SHOPIER GÜVENCESİYLE TAKSİT İMKANI</span>
      <span class="text-white/20" aria-hidden="true">/</span>
      <span class="px-8 whitespace-nowrap" aria-hidden="true">CC NEON'S CUSTOM NEON ATELIER</span>
      <span class="text-white/20" aria-hidden="true">/</span>
      <span class="px-8 whitespace-nowrap" aria-hidden="true">EL İŞÇİLİĞİ 1. SINIF SİLİKON LED</span>
      <span class="text-white/20" aria-hidden="true">/</span>
      <span class="px-8 whitespace-nowrap" aria-hidden="true">12V ADAPTÖR VE MONTAJ SETİ DAHİL</span>
      <span class="text-white/20" aria-hidden="true">/</span>
      <span class="px-8 whitespace-nowrap" aria-hidden="true">KIRILMAZ AHŞAP KASALI SİGORTALI KARGO</span>
      <span class="text-white/20" aria-hidden="true">/</span>
      <span class="px-8 whitespace-nowrap" aria-hidden="true">SHOPIER GÜVENCESİYLE TAKSİT İMKANI</span>
      <span class="text-white/20" aria-hidden="true">/</span>
    </div>
  </div>
</section>

<script is:inline>
  function initHeroGalleryShowcase() {
    const heroStage = document.getElementById("hero-stage");
    const scenePhoto = document.getElementById("hero-scene-photo");
    const mainText = document.getElementById("hero-showcase-main");
    const subText = document.getElementById("hero-showcase-sub");
    const badgeEl = document.getElementById("hero-showcase-badge");
    const plateSpecEl = document.getElementById("hero-plate-spec");
    const editLink = document.getElementById("hero-stage-edit-link");
    const acrylicPlate = document.getElementById("hero-acrylic-plate");
    const primaryCta = document.getElementById("hero-to-studio-cta");
    const sceneTabs = document.querySelectorAll(".hero-scene-tab");

    if (!heroStage || !mainText) return;

    const SCENES = [
      {
        badge: "ENSTALASYON 01 / ATELIER · 85x45 CM",
        plateSpec: "5MM ŞEFFAF AKRİLİK · 12V 2A ADAPTÖR",
        main: "CC NEON'S",
        sub: "Glow Custom Atelier",
        fontFamily: "'Tilt Neon', sans-serif",
        hex: "#35E7FF",
        rgb: "53, 231, 255",
        photo: "/scenes/hero-brick-cafe.webp",
        studioUrl: "/tasarla?text=CC+NEON%27S&color=cyan&font=modern&size=md",
      },
      {
        badge: "ENSTALASYON 02 / LOUNGE · 120x55 CM",
        plateSpec: "KONTUR KESİM PLEKSİ · IP67 DIŞ/İÇ MEKAN",
        main: "LOUNGE",
        sub: "Cocktails & Late Night",
        fontFamily: "'Oswald', sans-serif",
        hex: "#FFB020",
        rgb: "255, 176, 32",
        photo: "/scenes/b2b-lounge-scene.webp",
        studioUrl: "/tasarla#text=LOUNGE&color=amber&font=display&size=lg",
      },
      {
        badge: "ENSTALASYON 03 / CYBER · 90x45 CM",
        plateSpec: "SİYAH AKRİLİK TABAN · RGB KUMANDALI",
        main: "ON AIR",
        sub: "Cyber Studio Live",
        fontFamily: "'Tilt Neon', sans-serif",
        hex: "#FF2E88",
        rgb: "255, 46, 136",
        photo: "/scenes/b2b-gaming-room.webp",
        studioUrl: "/tasarla#text=ON%20AIR&color=pink&font=modern&size=md",
      },
    ];

    let activeIdx = 0;
    let timerId = null;

    function applyScene(idx) {
      activeIdx = idx;
      const s = SCENES[idx];
      if (!s) return;

      heroStage.style.setProperty("--neon-color", s.hex);
      heroStage.style.setProperty("--neon-rgb", s.rgb);
      document.documentElement.style.setProperty("--neon-color", s.hex);
      document.documentElement.style.setProperty("--neon-rgb", s.rgb);

      mainText.textContent = s.main;
      mainText.style.fontFamily = s.fontFamily;
      if (subText) subText.textContent = s.sub;
      if (badgeEl) badgeEl.textContent = s.badge;
      if (plateSpecEl) plateSpecEl.textContent = s.plateSpec;
      if (scenePhoto) scenePhoto.setAttribute("src", s.photo);
      if (editLink) editLink.setAttribute("href", s.studioUrl);
      if (acrylicPlate) acrylicPlate.setAttribute("href", s.studioUrl);
      if (primaryCta) primaryCta.setAttribute("href", s.studioUrl);

      sceneTabs.forEach((tab, i) => {
        const firstSpan = tab.querySelector("span:first-child");
        const secondSpan = tab.querySelector("span:last-child");
        if (i === idx) {
          tab.setAttribute("aria-selected", "true");
          tab.classList.remove("border-white/[0.07]", "bg-white/[0.02]");
          tab.classList.add("border-white/25", "bg-white/[0.08]");
          if (firstSpan) firstSpan.style.color = s.hex;
          if (secondSpan) {
            secondSpan.classList.remove("text-white/75");
            secondSpan.classList.add("text-white");
          }
        } else {
          tab.setAttribute("aria-selected", "false");
          tab.classList.remove("border-white/25", "bg-white/[0.08]");
          tab.classList.add("border-white/[0.07]", "bg-white/[0.02]");
          if (firstSpan) firstSpan.style.color = "rgba(255, 255, 255, 0.5)";
          if (secondSpan) {
            secondSpan.classList.remove("text-white");
            secondSpan.classList.add("text-white/75");
          }
        }
      });
    }

    function startAutoCycle() {
      if (timerId) clearInterval(timerId);
      timerId = setInterval(() => {
        const nextIdx = (activeIdx + 1) % SCENES.length;
        applyScene(nextIdx);
      }, 4800);
    }

    sceneTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const idx = Number(tab.getAttribute("data-scene-idx") || 0);
        applyScene(idx);
        startAutoCycle();
      });
    });

    if (window.__cacoonHeroTimer) {
      clearInterval(window.__cacoonHeroTimer);
    }

    applyScene(0);
    startAutoCycle();
    window.__cacoonHeroTimer = timerId;
  }

  document.addEventListener("DOMContentLoaded", initHeroGalleryShowcase);
  document.addEventListener("astro:page-load", initHeroGalleryShowcase);
</script>
