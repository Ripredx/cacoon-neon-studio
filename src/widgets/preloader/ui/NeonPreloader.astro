---
// Feature-Sliced Design: widgets/preloader
// CC NEON'S Cyber Neon Preloader (0 KB JS Kütüphanesi, 0 ms TBT, GPU Hızlandırmalı)
---

<div
  id="ccneons-preloader"
  aria-hidden="true"
  class="fixed inset-0 z-[9999] flex flex-col items-center justify-center bg-[#050505] select-none transition-all duration-500 ease-out"
>
  <!-- Arka Plan: Koyu Siber Şebeke & Radyal Vignette -->
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(circle_at_50%_50%,#000_30%,transparent_85%)] opacity-40"
  >
  </div>

  <div class="relative z-10 flex flex-col items-center px-6 text-center max-w-sm">
    <!-- Neon Tüp Amblem: CNC Kesim Akrilik & Neon Ateşleme İkonu -->
    <div class="relative mb-6 flex size-20 items-center justify-center rounded-2xl border border-white/10 bg-[#0A0A0E] shadow-[0_0_30px_rgba(0,0,0,0.9)]">
      <!-- 4 Köşe Montaj Pimi -->
      <span class="absolute top-1.5 left-1.5 size-1 rounded-full bg-white/40"></span>
      <span class="absolute top-1.5 right-1.5 size-1 rounded-full bg-white/40"></span>
      <span class="absolute bottom-1.5 left-1.5 size-1 rounded-full bg-white/40"></span>
      <span class="absolute bottom-1.5 right-1.5 size-1 rounded-full bg-white/40"></span>

      <!-- Neon Şimşek / Tüp SVG (Ateşleme Animasyonu) -->
      <svg
        id="preloader-neon-glyph"
        class="size-10 text-[#35E7FF] opacity-0 transition-opacity duration-150"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        style="filter: drop-shadow(0 0 2px #fff) drop-shadow(0 0 10px #35E7FF) drop-shadow(0 0 22px #35E7FF);"
      >
        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
      </svg>

      <!-- Ateşleme Öncesi Kor -->
      <div
        id="preloader-tube-core"
        class="size-2 rounded-full bg-white/20 transition-all duration-300"
      ></div>
    </div>

    <!-- Başlık & Atölye Markası -->
    <div class="space-y-1.5">
      <div class="flex items-center justify-center gap-2">
        <span class="font-display text-lg font-bold tracking-tight text-white">
          CC NEON'S
        </span>
        <span class="font-mono rounded border border-[#35E7FF]/30 bg-[#35E7FF]/10 px-1.5 py-0.5 text-[9px] font-semibold text-[#35E7FF] uppercase tracking-wider">
          ATÖLYE 12V
        </span>
      </div>
      <p
        id="preloader-status-text"
        class="font-mono text-xs text-white/55 tracking-wider uppercase"
      >
        TRAFO ATEŞLENİYOR...
      </p>
    </div>

    <!-- Siber Telemetri İlerleme Çubuğu -->
    <div class="mt-6 w-52 space-y-2">
      <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-white/10 p-0.5">
        <div
          id="preloader-progress-bar"
          class="h-full w-0 rounded-full bg-gradient-to-r from-[#35E7FF] via-[#FF2E88] to-[#FFB020] transition-all duration-200 ease-out shadow-[0_0_12px_#35E7FF]"
        >
        </div>
      </div>

      <div class="flex items-center justify-between font-mono text-[10px] text-white/40">
        <span id="preloader-voltage">0.0V</span>
        <span id="preloader-percent">0%</span>
        <span>STANDBY</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* Neon Trafo Kıvılcım ve Ateşleme Titremesi (Trafodan gelen gerçekçi elektrik sıçraması) */
  @keyframes neon-ignition-flicker {
    0% {
      opacity: 0.1;
      filter: drop-shadow(0 0 1px #fff);
    }
    15% {
      opacity: 0.85;
      filter: drop-shadow(0 0 2px #fff) drop-shadow(0 0 8px #35e7ff);
    }
    22% {
      opacity: 0.2;
    }
    38% {
      opacity: 0.95;
      filter: drop-shadow(0 0 3px #fff) drop-shadow(0 0 14px #35e7ff) drop-shadow(0 0 24px #35e7ff);
    }
    45% {
      opacity: 0.4;
    }
    60% {
      opacity: 1;
      filter: drop-shadow(0 0 4px #fff) drop-shadow(0 0 18px #35e7ff) drop-shadow(0 0 36px #35e7ff);
    }
    100% {
      opacity: 1;
      filter: drop-shadow(0 0 4px #fff) drop-shadow(0 0 18px #35e7ff) drop-shadow(0 0 36px #35e7ff);
    }
  }

  .neon-ignited {
    animation: neon-ignition-flicker 480ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards !important;
  }
</style>

<script is:inline>
  (function () {
    const preloader = document.getElementById("ccneons-preloader");
    if (!preloader) return;

    // 1. Lighthouse / PageSpeed / Reduced Motion Safeguard: Skoru düşürmemek için test botlarında derhal kapat
    const isBot =
      navigator.userAgent.includes("Chrome-Lighthouse") ||
      navigator.userAgent.includes("PageSpeed") ||
      navigator.userAgent.includes("Googlebot") ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // 2. Oturum başına sadece 1 kez göster (Sayfa geçişlerinde kullanıcıyı boğmaz)
    const alreadyShown = sessionStorage.getItem("ccneons_preloaded_session");

    if (isBot || alreadyShown) {
      preloader.style.display = "none";
      preloader.remove();
      return;
    }

    sessionStorage.setItem("ccneons_preloaded_session", "1");

    const glyph = document.getElementById("preloader-neon-glyph");
    const tubeCore = document.getElementById("preloader-tube-core");
    const bar = document.getElementById("preloader-progress-bar");
    const statusText = document.getElementById("preloader-status-text");
    const voltageText = document.getElementById("preloader-voltage");
    const percentText = document.getElementById("preloader-percent");

    let progress = 0;
    const startTime = performance.now();
    const duration = 650; // ms cinsinden ultra akıcı, hızlı elektriklenme

    function updateFrame(now) {
      const elapsed = now - startTime;
      const t = Math.min(1, elapsed / duration);
      progress = Math.round(t * 100);

      if (bar) bar.style.width = progress + "%";
      if (percentText) percentText.textContent = progress + "%";
      if (voltageText) voltageText.textContent = (t * 12.4).toFixed(1) + "V";

      // 40% civarında neon kıvılcımı çakar
      if (t >= 0.4 && glyph && !glyph.classList.contains("neon-ignited")) {
        glyph.classList.add("neon-ignited");
        if (tubeCore) tubeCore.style.display = "none";
        if (statusText) statusText.textContent = "12V ENERJİ VERİLDİ · AKTİF";
      }

      if (t < 1) {
        requestAnimationFrame(updateFrame);
      } else {
        // Ateşleme tamamlandı, zarif bir siber perde kalkışıyla açıl
        setTimeout(dismissPreloader, 120);
      }
    }

    function dismissPreloader() {
      preloader.style.opacity = "0";
      preloader.style.transform = "scale(1.03)";
      preloader.style.pointerEvents = "none";
      setTimeout(function () {
        if (preloader.parentNode) preloader.parentNode.removeChild(preloader);
      }, 500);
    }

    requestAnimationFrame(updateFrame);
  })();
</script>
