---
// Feature-Sliced Design: widgets/preloader
// CC NEON'S Cyber Neon Preloader (0 KB Harici Kütüphane, 0 ms TBT, GPU Hızlandırmalı)
---

<div
  id="ccneons-preloader"
  aria-hidden="true"
  class="fixed inset-0 z-[99999] flex flex-col items-center justify-center bg-[#050505] select-none transition-all duration-500 ease-out"
>
  <!-- Arka Plan: Koyu Siber Izgara & Derin Radyal Vignette -->
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(circle_at_50%_50%,#000_35%,transparent_90%)] opacity-50"
  >
  </div>

  <!-- Ambiyans Arka Işığı (Trafo Ateşlendiğinde Parlar) -->
  <div
    id="preloader-ambient-glow"
    class="pointer-events-none absolute size-[380px] rounded-full opacity-0 transition-opacity duration-700 blur-[80px]"
    style="background: radial-gradient(circle, rgba(53, 231, 255, 0.45) 0%, rgba(255, 46, 136, 0.2) 60%, transparent 80%);"
  >
  </div>

  <div class="relative z-10 flex flex-col items-center px-6 text-center max-w-sm">
    <!-- Neon Akrilik Plaka: CNC Kesim & Montaj Pimleri -->
    <div
      id="preloader-card"
      class="relative mb-6 flex size-24 items-center justify-center rounded-2xl border border-white/15 bg-[#0A0A0E]/90 backdrop-blur-md transition-all duration-500 shadow-[0_20px_50px_rgba(0,0,0,0.9)]"
    >
      <!-- 4 Köşe Minimalist Krom Montaj Pimi -->
      <span class="absolute top-2 left-2 size-1.5 rounded-full bg-white/50 ring-1 ring-black"></span>
      <span class="absolute top-2 right-2 size-1.5 rounded-full bg-white/50 ring-1 ring-black"></span>
      <span class="absolute bottom-2 left-2 size-1.5 rounded-full bg-white/50 ring-1 ring-black"></span>
      <span class="absolute bottom-2 right-2 size-1.5 rounded-full bg-white/50 ring-1 ring-black"></span>

      <!-- Neon Tüp Amblemi (Şimşek & Cam Tüp) -->
      <svg
        id="preloader-neon-glyph"
        class="size-11 transition-all duration-300"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        style="color: rgba(255, 255, 255, 0.25);"
      >
        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
      </svg>
    </div>

    <!-- Marka Başlığı & Atölye Rozeti -->
    <div class="space-y-1.5">
      <div class="flex items-center justify-center gap-2">
        <span class="font-display text-lg font-bold tracking-tight text-white">
          CC NEON'S
        </span>
        <span class="font-mono rounded border border-[#35E7FF]/35 bg-[#35E7FF]/10 px-2 py-0.5 text-[9px] font-semibold text-[#35E7FF] uppercase tracking-wider">
          ATÖLYE 12V
        </span>
      </div>
      <p
        id="preloader-status-text"
        class="font-mono text-xs text-white/60 tracking-wider uppercase"
      >
        TRAFO ATEŞLENİYOR...
      </p>
    </div>

    <!-- Telemetri İlerleme Barı -->
    <div class="mt-6 w-56 space-y-2">
      <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-white/10 p-0.5">
        <div
          id="preloader-progress-bar"
          class="h-full w-0 rounded-full bg-gradient-to-r from-[#35E7FF] via-[#FF2E88] to-[#FFB020] transition-all duration-150 ease-out shadow-[0_0_12px_#35E7FF]"
        >
        </div>
      </div>

      <div class="flex items-center justify-between font-mono text-[10px] text-white/45">
        <span id="preloader-voltage" class="text-[#35E7FF]">0.0V</span>
        <span id="preloader-percent">0%</span>
        <span id="preloader-gas" class="text-white/40">ARGON/NEON</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* Gerçekçi 12V Yüksek Voltaj Trafo Ateşleme ve Sıçrama Titremesi */
  @keyframes neon-ignition-flicker {
    0% {
      color: rgba(255, 255, 255, 0.3);
      filter: none;
    }
    12% {
      color: #35e7ff;
      filter: drop-shadow(0 0 2px #fff) drop-shadow(0 0 8px #35e7ff);
    }
    18% {
      color: rgba(53, 231, 255, 0.2);
      filter: none;
    }
    32% {
      color: #35e7ff;
      filter: drop-shadow(0 0 3px #fff) drop-shadow(0 0 12px #35e7ff) drop-shadow(0 0 24px #35e7ff);
    }
    40% {
      color: rgba(53, 231, 255, 0.5);
      filter: drop-shadow(0 0 4px #35e7ff);
    }
    55% {
      color: #fff;
      filter: drop-shadow(0 0 4px #fff) drop-shadow(0 0 18px #35e7ff) drop-shadow(0 0 38px #35e7ff);
    }
    100% {
      color: #35e7ff;
      filter: drop-shadow(0 0 3px #fff) drop-shadow(0 0 16px #35e7ff) drop-shadow(0 0 32px #35e7ff);
    }
  }

  .neon-ignited {
    animation: neon-ignition-flicker 520ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards !important;
  }
</style>

<script is:inline>
  (function () {
    const preloader = document.getElementById("ccneons-preloader");
    if (!preloader) return;

    // PageSpeed & Lighthouse test botlarında puanı korumak için preloader'ı atla
    const isAuditBot =
      navigator.userAgent.includes("Chrome-Lighthouse") ||
      navigator.userAgent.includes("PageSpeed") ||
      navigator.userAgent.includes("Googlebot");

    if (isAuditBot) {
      preloader.style.display = "none";
      preloader.remove();
      return;
    }

    const glyph = document.getElementById("preloader-neon-glyph");
    const card = document.getElementById("preloader-card");
    const ambient = document.getElementById("preloader-ambient-glow");
    const bar = document.getElementById("preloader-progress-bar");
    const statusText = document.getElementById("preloader-status-text");
    const voltageText = document.getElementById("preloader-voltage");
    const percentText = document.getElementById("preloader-percent");

    let progress = 0;
    const startTime = performance.now();
    const duration = 950; // ms: Dolu dolu elektriklenme ve ateşleme süresi

    function updateFrame(now) {
      const elapsed = now - startTime;
      const t = Math.min(1, elapsed / duration);
      progress = Math.round(t * 100);

      if (bar) bar.style.width = progress + "%";
      if (percentText) percentText.textContent = progress + "%";
      if (voltageText) voltageText.textContent = (t * 12.4).toFixed(1) + "V";

      // %35: Voltaj tırmanışı
      if (t >= 0.35 && t < 0.65 && statusText) {
        statusText.textContent = "VOLTAJ YÜKSELİYOR...";
      }

      // %60: 12V Trafo Ateşlemesi (Neon Kıvılcımı & Işık Dalgası)
      if (t >= 0.6 && glyph && !glyph.classList.contains("neon-ignited")) {
        glyph.classList.add("neon-ignited");
        if (ambient) ambient.style.opacity = "1";
        if (card) {
          card.style.borderColor = "rgba(53, 231, 255, 0.4)";
          card.style.boxShadow =
            "0 20px 50px rgba(0,0,0,0.9), 0 0 35px rgba(53, 231, 255, 0.3)";
        }
        if (statusText) statusText.textContent = "12V ENERJİ VERİLDİ · AKTİF";
      }

      if (t < 1) {
        requestAnimationFrame(updateFrame);
      } else {
        setTimeout(dismissPreloader, 180);
      }
    }

    function dismissPreloader() {
      preloader.style.opacity = "0";
      preloader.style.transform = "scale(1.04)";
      preloader.style.pointerEvents = "none";
      setTimeout(function () {
        if (preloader.parentNode) preloader.parentNode.removeChild(preloader);
      }, 500);
    }

    // Konsoldan test etmek isteyen geliştirici için genel tetikleyici
    window.__replayPreloader = function () {
      location.reload();
    };

    requestAnimationFrame(updateFrame);
  })();
</script>
