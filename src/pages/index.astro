---
import BaseLayout from "@/app/layouts/BaseLayout.astro";
import { getVerifiedProducts } from "@/entities/product/api/getProducts";
import { BUSINESS_CONFIG } from "@/shared/config/business";
import B2BShowcase from "@/widgets/b2b-showcase/ui/B2BShowcase.astro";
import Footer from "@/widgets/footer/ui/Footer.astro";
import Header from "@/widgets/header/ui/Header.astro";
import HeroShowcase from "@/widgets/hero-showcase/ui/HeroShowcase.astro";
import ProductCatalog from "@/widgets/product-catalog/ui/ProductCatalog.astro";

const products = getVerifiedProducts();

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": `${BUSINESS_CONFIG.siteUrl}/#business`,
      name: BUSINESS_CONFIG.name,
      url: BUSINESS_CONFIG.siteUrl,
      description:
        "Antalya / Manavgat merkezli gerçek el işçiliği özel üretim LED neon tabela, pleksi neon ve kanvas neon tablo atölyesi.",
      image: `${BUSINESS_CONFIG.siteUrl}/og-neon-card.png`,
      logo: `${BUSINESS_CONFIG.siteUrl}${BUSINESS_CONFIG.logoUrl}`,
      telephone: `+${BUSINESS_CONFIG.phones[0].raw}`,
      // Ev atölyesi: sokak adresi yok, yalnızca hizmet bölgesi bildirilir.
      address: {
        "@type": "PostalAddress",
        addressLocality: "Manavgat",
        addressRegion: "Antalya",
        addressCountry: "TR",
      },
      areaServed: [
        { "@type": "City", name: "Manavgat" },
        { "@type": "AdministrativeArea", name: "Antalya" },
        { "@type": "Country", name: "Türkiye" },
      ],
      sameAs: [BUSINESS_CONFIG.shopierUrl, BUSINESS_CONFIG.instagramUrl],
    },
    {
      "@type": "ItemList",
      name: "CC NEON'S Özel Üretim LED Neon Koleksiyonu",
      numberOfItems: products.length,
      itemListElement: products.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "Product",
          sku: product.id,
          name: product.title,
          description: `${product.title} - Özel üretim el işçiliği 1. sınıf silikon LED neon. 12V adaptör ve montaj kiti dahil, kırılmaz ahşap kasalı sigortalı kargo ile gönderilir.`,
          image: product.imageUrl,
          brand: {
            "@type": "Brand",
            name: "CC NEON'S",
          },
          offers: {
            "@type": "Offer",
            url: product.shopierUrl,
            priceCurrency: "TRY",
            price: product.price,
            availability: "https://schema.org/InStock",
            shippingDetails: {
              "@type": "OfferShippingDetails",
              shippingRate: {
                "@type": "MonetaryAmount",
                value: 0,
                currency: "TRY",
              },
              shippingDestination: {
                "@type": "DefinedRegion",
                addressCountry: "TR",
              },
              deliveryTime: {
                "@type": "ShippingDeliveryTime",
                handlingTime: {
                  "@type": "QuantitativeValue",
                  minValue: 1,
                  maxValue: 3,
                  unitCode: "DAY",
                },
                transitTime: {
                  "@type": "QuantitativeValue",
                  minValue: 1,
                  maxValue: 3,
                  unitCode: "DAY",
                },
              },
            },
            hasMerchantReturnPolicy: {
              "@type": "MerchantReturnPolicy",
              applicableCountry: "TR",
              returnPolicyCategory:
                "https://schema.org/MerchantReturnFiniteReturnWindow",
              merchantReturnDays: 14,
              returnMethod: "https://schema.org/ReturnByMail",
              returnFees: "https://schema.org/FreeReturn",
            },
          },
        },
      })),
    },
  ],
};
---

<BaseLayout>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <Header currentPath="/" />
  <main>
    <HeroShowcase />
    <ProductCatalog />
    <B2BShowcase />
  </main>
  <Footer />
</BaseLayout>
